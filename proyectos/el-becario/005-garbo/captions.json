[
 {
  "start": 0.025,
  "end": 1.034,
  "text": "Los nazis pagaban"
 },
 {
  "start": 1.044,
  "end": 2.978,
  "text": "a veintisiete espías."
 },
 {
  "start": 3.044,
  "end": 3.865,
  "text": "Todos inventados"
 },
 {
  "start": 3.875,
  "end": 5.11,
  "text": "por un español."
 },
 {
  "start": 5.12,
  "end": 5.789,
  "text": "Cómo fabricar"
 },
 {
  "start": 5.799,
  "end": 6.505,
  "text": "un espía."
 },
 {
  "start": 6.515,
  "end": 7.157,
  "text": "Paso uno:"
 },
 {
  "start": 7.167,
  "end": 8.057,
  "text": "que te rechacen."
 },
 {
  "start": 8.067,
  "end": 8.887,
  "text": "Joan Pujol,"
 },
 {
  "start": 8.897,
  "end": 9.604,
  "text": "antinazi,"
 },
 {
  "start": 9.614,
  "end": 10.472,
  "text": "se ofreció tres"
 },
 {
  "start": 10.482,
  "end": 10.782,
  "text": "veces"
 },
 {
  "start": 10.782,
  "end": 12.152,
  "text": "a los ingleses."
 },
 {
  "start": 12.52,
  "end": 12.887,
  "text": "Como mis"
 },
 {
  "start": 12.897,
  "end": 13.719,
  "text": "currículums."
 },
 {
  "start": 13.729,
  "end": 14.549,
  "text": "Paso dos:"
 },
 {
  "start": 14.559,
  "end": 15.833,
  "text": "ofrécete al enemigo."
 },
 {
  "start": 15.843,
  "end": 16.173,
  "text": "Lo mandan"
 },
 {
  "start": 16.183,
  "end": 17.18,
  "text": "a Inglaterra…"
 },
 {
  "start": 17.19,
  "end": 17.607,
  "text": "y se queda"
 },
 {
  "start": 17.617,
  "end": 18.293,
  "text": "en Lisboa."
 },
 {
  "start": 18.303,
  "end": 19.274,
  "text": "Paso tres:"
 },
 {
  "start": 19.284,
  "end": 20.217,
  "text": "espía con una guía"
 },
 {
  "start": 20.227,
  "end": 21.047,
  "text": "turística."
 },
 {
  "start": 21.057,
  "end": 21.651,
  "text": "Según él,"
 },
 {
  "start": 21.661,
  "end": 22.519,
  "text": "en Glasgow harían"
 },
 {
  "start": 22.529,
  "end": 23.161,
  "text": "lo que fuera"
 },
 {
  "start": 23.171,
  "end": 24.519,
  "text": "por un litro de vino."
 },
 {
  "start": 24.529,
  "end": 25.236,
  "text": "Paso cuatro:"
 },
 {
  "start": 25.246,
  "end": 26.028,
  "text": "que los ingleses"
 },
 {
  "start": 26.038,
  "end": 27.425,
  "text": "por fin te fichen."
 },
 {
  "start": 27.435,
  "end": 28.406,
  "text": "Nombre en clave:"
 },
 {
  "start": 28.416,
  "end": 29.01,
  "text": "Garbo."
 },
 {
  "start": 29.02,
  "end": 29.802,
  "text": "Mata a un espía"
 },
 {
  "start": 29.812,
  "end": 30.595,
  "text": "inventado…"
 },
 {
  "start": 30.605,
  "end": 31.462,
  "text": "y Alemania paga"
 },
 {
  "start": 31.472,
  "end": 32.806,
  "text": "la pensión a la viuda."
 },
 {
  "start": 32.816,
  "end": 34.005,
  "text": "Que tampoco existía."
 },
 {
  "start": 34.015,
  "end": 35.024,
  "text": "Paso cinco:"
 },
 {
  "start": 35.034,
  "end": 35.929,
  "text": "convence a los nazis"
 },
 {
  "start": 35.939,
  "end": 36.835,
  "text": "de que Normandía es"
 },
 {
  "start": 36.845,
  "end": 37.703,
  "text": "un señuelo."
 },
 {
  "start": 37.713,
  "end": 38.231,
  "text": "Veintiuna"
 },
 {
  "start": 38.241,
  "end": 39.137,
  "text": "divisiones,"
 },
 {
  "start": 39.147,
  "end": 40.194,
  "text": "esperando en Calais."
 },
 {
  "start": 40.204,
  "end": 40.797,
  "text": "Premio:"
 },
 {
  "start": 40.807,
  "end": 41.741,
  "text": "Cruz de Hierro nazi"
 },
 {
  "start": 41.751,
  "end": 42.866,
  "text": "y medalla inglesa."
 },
 {
  "start": 42.876,
  "end": 43.394,
  "text": "Unos,"
 },
 {
  "start": 43.404,
  "end": 44.375,
  "text": "por creérsela."
 },
 {
  "start": 44.385,
  "end": 44.904,
  "text": "Otros,"
 },
 {
  "start": 44.914,
  "end": 45.885,
  "text": "por inventarla."
 },
 {
  "start": 45.895,
  "end": 47.168,
  "text": "Expediente cerrado."
 },
 {
  "start": 47.178,
  "end": 47.998,
  "text": "Pagaban a espías"
 },
 {
  "start": 48.008,
  "end": 49.508,
  "text": "que no existían."
 },
 {
  "start": 49.518,
  "end": 51.08,
  "text": "Yo existo."
 },
 {
  "start": 51.09,
  "end": 52.136,
  "text": "Y nada."
 }
]