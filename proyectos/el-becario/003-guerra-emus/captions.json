[
 {
  "start": 0.03,
  "end": 1.7,
  "text": "En 1932,"
 },
 {
  "start": 1.71,
  "end": 2.7,
  "text": "Australia le declaró"
 },
 {
  "start": 2.71,
  "end": 3.1,
  "text": "la guerra"
 },
 {
  "start": 3.11,
  "end": 4.02,
  "text": "a los emús."
 },
 {
  "start": 4.03,
  "end": 5.14,
  "text": "Y no la ganó."
 },
 {
  "start": 5.15,
  "end": 7.02,
  "text": "Expediente 003."
 },
 {
  "start": 7.03,
  "end": 8.1,
  "text": "20.000 emús se comen"
 },
 {
  "start": 8.11,
  "end": 8.66,
  "text": "el trigo,"
 },
 {
  "start": 8.67,
  "end": 9.42,
  "text": "y el gobierno"
 },
 {
  "start": 9.43,
  "end": 10.33,
  "text": "manda..."
 },
 {
  "start": 10.386,
  "end": 10.686,
  "text": "espera,"
 },
 {
  "start": 10.686,
  "end": 11.84,
  "text": "que lo leo bien..."
 },
 {
  "start": 11.85,
  "end": 13.29,
  "text": "¿¡Al ejército!?"
 },
 {
  "start": 13.3,
  "end": 14.01,
  "text": "Un mayor,"
 },
 {
  "start": 14.02,
  "end": 14.93,
  "text": "dos ametralladoras"
 },
 {
  "start": 14.94,
  "end": 16.25,
  "text": "y 10.000 balas."
 },
 {
  "start": 16.26,
  "end": 17.45,
  "text": "Contra un pájaro..."
 },
 {
  "start": 17.46,
  "end": 18.81,
  "text": "que no sabe volar."
 },
 {
  "start": 18.82,
  "end": 19.93,
  "text": "Primera emboscada."
 },
 {
  "start": 19.94,
  "end": 21.377,
  "text": "Disparan..."
 },
 {
  "start": 21.387,
  "end": 22.23,
  "text": "y la ametralladora"
 },
 {
  "start": 22.24,
  "end": 23.15,
  "text": "se atasca."
 },
 {
  "start": 23.16,
  "end": 23.79,
  "text": "Como la impresora"
 },
 {
  "start": 23.8,
  "end": 24.71,
  "text": "del Archivo."
 },
 {
  "start": 24.72,
  "end": 25.23,
  "text": "Se reparten"
 },
 {
  "start": 25.24,
  "end": 25.95,
  "text": "en grupitos,"
 },
 {
  "start": 25.96,
  "end": 27.11,
  "text": "con vigía y todo."
 },
 {
  "start": 27.12,
  "end": 27.91,
  "text": "Más organizados"
 },
 {
  "start": 27.92,
  "end": 29.19,
  "text": "que mi departamento."
 },
 {
  "start": 29.2,
  "end": 29.5,
  "text": "Montan"
 },
 {
  "start": 29.5,
  "end": 30.19,
  "text": "la ametralladora"
 },
 {
  "start": 30.2,
  "end": 31.333,
  "text": "en un camión."
 },
 {
  "start": 31.343,
  "end": 31.643,
  "text": "Spoiler:"
 },
 {
  "start": 31.643,
  "end": 32.79,
  "text": "los emús corren más."
 },
 {
  "start": 32.8,
  "end": 33.95,
  "text": "El mayor presume:"
 },
 {
  "start": 33.96,
  "end": 35.59,
  "text": "986 emús,"
 },
 {
  "start": 35.6,
  "end": 37.83,
  "text": "con 9.860 balas."
 },
 {
  "start": 37.84,
  "end": 39.417,
  "text": "Diez balas por emú."
 },
 {
  "start": 39.427,
  "end": 40.33,
  "text": "Diez."
 },
 {
  "start": 40.34,
  "end": 40.97,
  "text": "Y encima dice"
 },
 {
  "start": 40.98,
  "end": 42.29,
  "text": "que aguantan balas..."
 },
 {
  "start": 42.3,
  "end": 43.69,
  "text": "como tanques."
 },
 {
  "start": 43.7,
  "end": 44.74,
  "text": "¿Y el resto?"
 },
 {
  "start": 44.773,
  "end": 45.51,
  "text": "Siguen ahí."
 },
 {
  "start": 45.52,
  "end": 46.87,
  "text": "Expediente cerrado."
 },
 {
  "start": 46.88,
  "end": 47.83,
  "text": "A ellos les mandaron"
 },
 {
  "start": 47.84,
  "end": 49.62,
  "text": "10.000 balas."
 },
 {
  "start": 49.72,
  "end": 50.31,
  "text": "A mí,"
 },
 {
  "start": 50.32,
  "end": 51.71,
  "text": "ni un sueldo."
 }
]