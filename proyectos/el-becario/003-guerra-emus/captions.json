[
 {
  "start": 0.03,
  "end": 1.7,
  "text": "En 1932,"
 },
 {
  "start": 1.71,
  "end": 2.7,
  "text": "Australia le declaró"
 },
 {
  "start": 2.71,
  "end": 3.1,
  "text": "la guerra"
 },
 {
  "start": 3.11,
  "end": 4.02,
  "text": "a los emús."
 },
 {
  "start": 4.03,
  "end": 5.14,
  "text": "Y no la ganó."
 },
 {
  "start": 5.15,
  "end": 7.02,
  "text": "Expediente 003."
 },
 {
  "start": 7.03,
  "end": 8.1,
  "text": "20.000 emús se comen"
 },
 {
  "start": 8.11,
  "end": 8.66,
  "text": "el trigo,"
 },
 {
  "start": 8.67,
  "end": 9.42,
  "text": "y el gobierno"
 },
 {
  "start": 9.43,
  "end": 10.33,
  "text": "manda..."
 },
 {
  "start": 10.386,
  "end": 10.686,
  "text": "espera,"
 },
 {
  "start": 10.686,
  "end": 11.84,
  "text": "que lo leo bien..."
 },
 {
  "start": 11.85,
  "end": 13.29,
  "text": "¿¡Al ejército!?"
 },
 {
  "start": 13.3,
  "end": 14.01,
  "text": "Un mayor,"
 },
 {
  "start": 14.02,
  "end": 14.93,
  "text": "dos ametralladoras"
 },
 {
  "start": 14.94,
  "end": 16.25,
  "text": "y 10.000 balas."
 },
 {
  "start": 16.26,
  "end": 17.45,
  "text": "Contra un pájaro..."
 },
 {
  "start": 17.46,
  "end": 18.81,
  "text": "que no sabe volar."
 },
 {
  "start": 18.82,
  "end": 19.93,
  "text": "Primera emboscada."
 },
 {
  "start": 19.94,
  "end": 20.877,
  "text": "Disparan..."
 },
 {
  "start": 20.887,
  "end": 21.73,
  "text": "y la ametralladora"
 },
 {
  "start": 21.74,
  "end": 22.65,
  "text": "se atasca."
 },
 {
  "start": 22.66,
  "end": 23.29,
  "text": "Como la impresora"
 },
 {
  "start": 23.3,
  "end": 24.21,
  "text": "del Archivo."
 },
 {
  "start": 24.22,
  "end": 24.73,
  "text": "Se reparten"
 },
 {
  "start": 24.74,
  "end": 25.45,
  "text": "en grupitos,"
 },
 {
  "start": 25.46,
  "end": 26.61,
  "text": "con vigía y todo."
 },
 {
  "start": 26.62,
  "end": 27.41,
  "text": "Más organizados"
 },
 {
  "start": 27.42,
  "end": 28.69,
  "text": "que mi departamento."
 },
 {
  "start": 28.7,
  "end": 29.0,
  "text": "Montan"
 },
 {
  "start": 29.0,
  "end": 29.69,
  "text": "la ametralladora"
 },
 {
  "start": 29.7,
  "end": 30.833,
  "text": "en un camión."
 },
 {
  "start": 30.843,
  "end": 31.143,
  "text": "Spoiler:"
 },
 {
  "start": 31.143,
  "end": 32.29,
  "text": "los emús corren más."
 },
 {
  "start": 32.3,
  "end": 33.45,
  "text": "El mayor presume:"
 },
 {
  "start": 33.46,
  "end": 35.09,
  "text": "986 emús,"
 },
 {
  "start": 35.1,
  "end": 37.33,
  "text": "con 9.860 balas."
 },
 {
  "start": 37.34,
  "end": 38.917,
  "text": "Diez balas por emú."
 },
 {
  "start": 38.927,
  "end": 39.83,
  "text": "Diez."
 },
 {
  "start": 39.84,
  "end": 40.47,
  "text": "Y encima dice"
 },
 {
  "start": 40.48,
  "end": 41.79,
  "text": "que aguantan balas..."
 },
 {
  "start": 41.8,
  "end": 43.19,
  "text": "como tanques."
 },
 {
  "start": 43.2,
  "end": 44.24,
  "text": "¿Y el resto?"
 },
 {
  "start": 44.273,
  "end": 45.01,
  "text": "Siguen ahí."
 },
 {
  "start": 45.02,
  "end": 46.37,
  "text": "Expediente cerrado."
 },
 {
  "start": 46.38,
  "end": 47.33,
  "text": "A ellos les mandaron"
 },
 {
  "start": 47.34,
  "end": 49.12,
  "text": "10.000 balas."
 },
 {
  "start": 49.22,
  "end": 49.81,
  "text": "A mí,"
 },
 {
  "start": 49.82,
  "end": 51.21,
  "text": "ni un sueldo."
 }
]