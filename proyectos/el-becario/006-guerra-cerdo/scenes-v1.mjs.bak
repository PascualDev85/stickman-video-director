// EXPEDIENTE 006 — «La Guerra del Cerdo» (San Juan, 1859-72) (Historias Sin Cabeza). Short 9:16, ~47 s.
// Guion v2 (guion.md). Voz: toma A ×1,06 + 7 pausas recortadas + 0,35 s de pausa tras «tiro.» (10,42) = 46,71 s.
import fs from 'node:fs';
import {becario, granjero, soldadoUS, ingles, almirante, kaiser, casaca, P, E, R, G, S, deg, INK, PAPER, ctext} from '../kit.mjs';
import {GROUND, RED, YEL, tag, captionTrack, fill, band, mix, r3, eOut, eInOut, eBack, shake, sample, camF, slam, flash, cloud, office, desk, makeEpisode, F, bubble, move} from '../lib.mjs';
import {cerdo, huerto, billete, usFlag, ukFlag, asta, rifle, humo, esposas, tienda, canon, barco, lapida, laudo, mapaNO, mapCam, pin, SJ} from './props.mjs';

const {WORDS, shots, shot, mouth} = makeEpisode('words.json');
const VOICE = 46.71, END = 47.2; // VOICE = duración real de narration.mp3
// Contador fijo (BIBLIA): N = 215 + días desde el 11-nov-2026 hasta la PUBLICACIÓN. Recalcular si cambia la fecha.
const PUB = '2026-11-21', DAYS = 215 + Math.round((Date.parse(PUB) - Date.parse('2026-11-11')) / 864e5);

// ---------- movimiento de personajes ----------
const keysIn = (d, ks) => ks.filter(k => k.t >= 0 && k.t <= d).sort((a, b) => a.t - b.t).filter((k, i, a) => !i || k.t > a[i - 1].t);
const nod = (d, ts, a = 7, w = 0.12) => keysIn(d, [{t: 0, angle: 0}, ...ts.flatMap(t => [{t: r3(t - w), angle: 0}, {t: r3(t), angle: deg(a)}, {t: r3(t + w), angle: 0}]), {t: d, angle: 0}]);
const laugh = (d, t0, t1, a = 5, per = 0.16) => keysIn(d, [{t: 0, angle: 0}, {t: r3(t0), angle: 0}, ...Array.from({length: Math.floor((t1 - t0) / per)}, (_, k) => ({t: r3(t0 + (k + 1) * per), angle: deg(k % 2 ? -a : a)})), {t: r3(Math.min(d, t1 + per)), angle: 0}, {t: d, angle: 0}]);
const hop = (d, x, y, ts, h = 45) => keysIn(d, [{t: 0, x, y}, ...ts.flatMap(t => [{t: r3(t - 0.01), x, y}, {t: r3(t + 0.1), x, y: y - h}, {t: r3(t + 0.24), x, y}]), {t: d, x, y}]);
const flinch = (d, x, y, ts, dx = 40) => keysIn(d, [{t: 0, x, y}, ...ts.flatMap(t => [{t: r3(t - 0.02), x, y}, {t: r3(t + 0.06), x: x + dx, y}, {t: r3(t + 0.3), x, y}]), {t: d, x, y}]);

// ---------- decorados ----------
const SKY = '#9fd3f0';
const isla = (d, {grass = '#86c26e'} = {}) => [fill(SKY), cloud(250, 300, 0.7, d, 40), cloud(980, 420, 0.5, d, 60), band(1020, 440, '#6fb0d6'),
  S([['M', -60, 1090], ['Q', 300, 900, 640, 960], ['Q', 1000, 900, 1340, 1090], ['L', 1340, 1500], ['L', -60, 1500], ['Z']], '#6fa85a', {lineWidth: 9}), band(1480, 900, grass), band(1480, 14, '#4f8a40')];
const mar = d => [fill(SKY), cloud(300, 280, 0.8, d, 50), cloud(950, 380, 0.6, d, 60), band(980, 1400, '#5fa3cf'), band(980, 14, '#3a7aa8'),
  ...Array.from({length: 14}, (_, i) => { const x = (i * 211) % 1300, y = 1100 + (i * 97) % 900; return P([['M', x, y], ['Q', x + 30, y - 16, x + 60, y], ['Q', x + 90, y + 16, x + 120, y]], {stroke: 'rgba(255,255,255,0.6)', lineWidth: 6}); })];
const US = (i, o) => soldadoUS(1 + (i % 2), o), UK = (i, o) => casaca(1 + (i % 2), o);
/** Fila de soldados (fn(i, opts)). hopAt: t locales donde saltan. */
const fila = (fn, n, x0, dx, y, sc, d, {look = 1, hopAt = [], walk = 0, expr = 'serio'} = {}) => Array.from({length: n}, (_, i) => fn(i, {x: x0 + i * dx, y, scale: sc, expr, look, idle: {dur: d},
  ...(walk ? {walk: {dur: d, period: 0.4, stride: 16}, move: [{t: 0, x: x0 + i * dx - walk}, {t: d, x: x0 + i * dx}]} : hopAt.length ? {move: hop(d, x0 + i * dx, y, hopAt.map(t => t + i * 0.05), 30)} : {})}));

// ---------- miniatura (= fotograma 1 y último) ----------
const hookSet = (d, {hops = [], pigDur = d} = {}) => [...isla(d),
  ...fila(US, 3, 150, 110, 1640, 0.5, d, {look: 1, hopAt: hops}), ...fila(UK, 3, 850, 110, 1640, 0.5, d, {look: -1, hopAt: hops}),
  asta(usFlag({}, 150), {x: 80, y: 1600, h: 360, dur: d}), asta(ukFlag({}, 150), {x: 1200, y: 1600, h: 360, dur: d}),
  cerdo({x: 640, y: 1870, scale: 1.45, eat: true, dur: pigDur})];
const thumb = (d, fade = 0, t0 = 0) => {
  const line = (text, y, size, color) => ({...ctext(text, 380, y, size, {maxW: 560, color}), outline: INK, outlineWidth: 16});
  const body = G([G([tag('HISTORIA REAL · 1859', 700, 44, {pop: false, color: RED, tilt: -2})], {x: -250}), G([line('LA GUERRA', 770, 124, YEL), line('DEL CERDO', 915, 124, PAPER)], {angle: deg(-4)})]);
  return fade ? G([body], {from: t0, keys: sample(t => ({alpha: (t - t0) / fade}), t0, Math.min(d, t0 + fade))}) : body;
};
/** Ventanita con el Becario reaccionando (de t0 al final del plano). */
const becCam = (t0, d, expr, {x = 200, y = 700, look = 1, s: sc = 1} = {}) => G([R(-170, -235, 340, 470, {radius: 24, fill: '#e8e2d0', lineWidth: 10}), R(-120, -200, 110, 150, {radius: 4, fill: '#c9d6e3', lineWidth: 6}),
  becario({x: 0, y: 440, scale: 0.85, expr, look, bust: true, idle: {dur: d}, headKeys: [{t: 0, angle: 0}, {t: t0 + 0.25, angle: 0}, {t: t0 + 0.4, angle: deg(-6 * look)}, {t: d, angle: deg(-6 * look)}]}),
  R(-170, 150, 340, 85, {radius: 0, fill: '#8a6a4a', lineWidth: 8}), R(-170, -235, 340, 470, {radius: 24, fill: 'none', lineWidth: 12})],
  {x, y, from: r3(t0), keys: sample(t => ({s: sc * mix(0.3, 1, eBack((t - t0) / 0.2)), a: -3}), r3(t0), d)});

// ================= SHOTS =================
// 0–1.45 · «Dos imperios.» — miniatura: dos ejércitos y el cerdo en medio; los soldados saltan y el cerdo mordisquea antes de 0,5 s.
shot(0, 1.45, d => [camF(hookSet(d, {hops: [0.12]}), d, move.dolly(d, 1.0, 1.06), 640, 1300), G([thumb(d)], {to: 1.3})]);
// 1.45–3.1 · «Más de dos mil hombres.» — grúa: se abre el plano y aparecen filas enteras y barcos.
shot(1.45, 3.1, d => [camF([...isla(d), band(1020, 440, '#6fb0d6'),
  barco({x: 1000, y: 1180, scale: 0.4, dur: d, flip: true}), barco({x: 300, y: 1200, scale: 0.35, dur: d, flag: 'us'}),
  ...fila(US, 7, 60, 90, 1560, 0.4, d, {look: 1, hopAt: [0.5]}), ...fila(UK, 7, 700, 90, 1560, 0.4, d, {look: -1, hopAt: [0.6]}),
  ...fila(US, 6, 100, 90, 1690, 0.45, d, {look: 1}), ...fila(UK, 6, 740, 90, 1690, 0.45, d, {look: -1}),
  cerdo({x: 640, y: 1800, scale: 0.5, eat: true, dur: d})], d, move.crane(d, 200, 1.3, 1.0), 640, 1300)]);
// 3.1–4.23 · «Por un cerdo.» — primer plano del cerdo (zoom de lente) que mira a cámara.
shot(3.1, 4.23, d => [camF([...isla(d), cerdo({x: 640, y: 1900, scale: 1.8, eat: false, dur: d})], d, move.zoom(d, 1.0, 1.15, 0.25), 640, 1400), tag('EL CAUSANTE', 420, 66, {t0: 0.15, tilt: -3})]);
// 4.23–5.93 · «1859.» — la isla de San Juan, una granja con humo; paneo.
shot(4.23, 5.93, d => [camF([...isla(d),
  R(380, 1180, 360, 280, {radius: 6, fill: '#d9b98a', lineWidth: 9}), S([['M', 350, 1190], ['L', 560, 1020], ['L', 770, 1190], ['Z']], '#a8432f', {lineWidth: 9}), R(520, 1330, 80, 130, {radius: 4, fill: '#5a3a22', lineWidth: 7}), R(420, 1260, 70, 70, {radius: 4, fill: '#9fd3f0', lineWidth: 7}),
  G([E(0, 0, 70, 50, {fill: '#eeeeee', stroke: 'none'}), E(24, -40, 60, 44, {fill: '#f4f4f4', stroke: 'none'})], {x: 690, y: 960, keys: sample(t => ({y: 960 - t * 80, alpha: 1 - t / d}), 0, d)}),
  huerto({x: 950, y: 1640}, 3), huerto({x: 270, y: 1700}, 3)], d, move.pan(d, 160, 1.1), 640, 1300), tag('ISLA DE SAN JUAN · COSTA OESTE', 420, 54, {t0: 0.1, tilt: -2})]);
// 5.93–9.28 · «Un granjero americano pilla a un cerdo comiéndose sus patatas.» — el granjero lo ve, el cerdo come sin parar.
shot(5.93, 9.28, d => [camF([...isla(d), huerto({x: 880, y: 1660}, 4),
  granjero({x: 330, y: 1720, scale: 1.15, expr: 'serio', look: 1, idle: {dur: d}, talk: mouth(5.93, 9.28), armR: {shoulder: 30, elbow: 40}, gestures: [{t0: 1.7, t1: 3.0, arm: 'R', shoulder: 105, elbow: 20}], headKeys: nod(d, [1.9], -7, 0.15)}),
  cerdo({x: 890, y: 1790, scale: 0.95, flip: true, eat: true, dur: d})], d, move.dolly(d, 1.0, 1.1), 640, 1300), tag('LYMAN CUTLAR', 420, 66, {t0: 0.15, tilt: -2})]);
// 9.28–10.78 · «Y le pega un tiro.» — apunta, PAM (en la pausa insertada), el cerdo cae patas arriba. Sin sangre.
const BANG = 1.0;
shot(9.28, 10.78, d => [camF([...isla(d), huerto({x: 880, y: 1660}, 4),
  granjero({x: 330, y: 1720, scale: 1.15, expr: 'serio', look: 1, idle: {dur: d}, armR: {shoulder: 85, elbow: 5, hold: [rifle({x: 20, y: 70})]}, armL: {shoulder: 80, elbow: 40}, headKeys: nod(d, [BANG], -6, 0.08)}),
  cerdo({x: 890, y: 1790, scale: 0.95, flip: true, eat: true, dur: d, to: BANG}), cerdo({x: 890, y: 1790, scale: 0.95, flip: true, dead: true, from: BANG}),
  humo(560, 1560, BANG, d)], d, t => ({s: 1.1, ...shake(t, BANG, 0.4, 22)}), 640, 1300), flash(BANG, 0.1, '#fff2b0', 0.7), slam('¡PAM!', 640, 800, 150, BANG, d, {outline: true, color: RED, tilt: -8, stamp: true, from: 1.3})]);
// 10.78–12.06 · «Era de una empresa británica.» — el dueño (de la Compañía de la Bahía de Hudson) llora al cerdo; bandera británica.
shot(10.78, 12.15, d => [camF([...isla(d), asta(ukFlag({}, 170), {x: 1130, y: 1500, h: 470, dur: d}), cerdo({x: 330, y: 1810, scale: 0.95, dead: true}),
  ingles({x: 800, y: 1730, scale: 1.2, expr: 'sorpresa', look: -1, idle: {dur: d}, talk: mouth(10.78, 12.15), armL: {shoulder: 150, elbow: 30}, armR: {shoulder: 150, elbow: 30}, headKeys: laugh(d, 0.2, 1.2, 6, 0.2)})],
  d, move.handheld(d, 6, 1.06), 640, 1300), tag('COMPAÑÍA DE LA BAHÍA DE HUDSON', 420, 46, {t0: 0.1, tilt: 2})]);
// 12.15–13.64 · «Ofrece diez dólares.» — el granjero tiende un billete de 10; el otro niega con la cabeza.
shot(12.15, 13.64, d => [camF([...isla(d), cerdo({x: 640, y: 1850, scale: 0.7, dead: true}),
  granjero({x: 300, y: 1730, scale: 1.15, expr: 'contento', look: 1, idle: {dur: d}, talk: mouth(12.15, 13.64), armR: {shoulder: 80, elbow: 20, hold: [billete(10, {x: 30, y: 10, scaleX: 0.5, scaleY: 0.5})]}, headKeys: nod(d, [0.3], 6)}),
  ingles({x: 940, y: 1730, scale: 1.15, expr: 'serio', look: -1, idle: {dur: d}, headKeys: laugh(d, 0.5, 1.3, 9, 0.2)})], d, move.dolly(d, 1.0, 1.08), 640, 1300)]);
// 13.64–14.71 · «Le exigen cien.» — billete gigante de 100; el granjero se echa atrás; el Becario en ventanita.
shot(13.64, 14.71, d => [camF([...isla(d), cerdo({x: 640, y: 1850, scale: 0.7, dead: true}),
  granjero({x: 300, y: 1730, scale: 1.1, expr: 'miedo', look: 1, idle: {dur: d}, move: flinch(d, 300, 1730, [0.15], -45), armL: {shoulder: 110, elbow: 40}}),
  ingles({x: 940, y: 1730, scale: 1.15, expr: 'serio', look: -1, idle: {dur: d}, armL: {shoulder: 75, elbow: 25, hold: [billete(100, {x: -30, y: 0, scaleX: 0.85, scaleY: 0.85})]}}),
], d, move.dolly(d, 1.0, 1.1), 640, 1300), becCam(0.3, d, 'sarcastico', {x: 200, y: 500, s: 0.8})]);
// 14.71–17.66 · «El problema: los dos países reclamaban aquella isla.» — mapa real; dos banderas convergen sobre San Juan.
const FL = (flag, from, to, t0, t1, d) => G([flag], {from: r3(t0), keys: sample(t => ({x: mix(from[0], to[0], eInOut((t - t0) / (t1 - t0))), y: mix(from[1], to[1], eInOut((t - t0) / (t1 - t0)))}), r3(t0), d)});
shot(14.71, 17.66, d => [camF([...mapaNO({labels: false}), G([ctext('CANADÁ', 640, 700, 54, {maxW: 340, color: '#5a4632'}), ctext('EE. UU.', 760, 1260, 54, {maxW: 300, color: '#5a4632'}), ctext('ISLA DE VANCOUVER', 400, 900, 38, {maxW: 360, color: '#5a4632'})], {to: 0.9}), pin(d),
  FL(usFlag({scaleX: 0.7, scaleY: 0.7}, 120), [SJ[0] + 150, SJ[1] + 230], [SJ[0] + 36, SJ[1] + 22], 1.0, 2.0, d),
  FL(ukFlag({scaleX: 0.7, scaleY: 0.7}, 120), [SJ[0] - 330, SJ[1] - 190], [SJ[0] - 90, SJ[1] - 22], 1.0, 2.0, d),
  ctext('SAN JUAN', SJ[0] + 70, SJ[1] - 70, 34, {maxW: 200, color: RED})],
  d, t => mapCam(SJ[0], SJ[1], mix(1.0, 2.2, eInOut(t / d))), 640, 1000), tag('LA FRONTERA NO ESTABA CLARA', 420, 50, {t0: 0.1, tilt: -2})]);
// 17.66–19.66 · «Los británicos amenazan con detenerlo.» — el inglés llega con esposas; el granjero tiembla.
shot(17.66, 19.66, d => [camF([...isla(d), cerdo({x: 560, y: 1850, scale: 0.7, dead: true}),
  granjero({x: 290, y: 1730, scale: 1.1, expr: 'miedo', look: 1, idle: {dur: d}, armL: {shoulder: 150, elbow: 20}, armR: {shoulder: 150, elbow: 20}, headKeys: laugh(d, 0.2, 1.8, 5, 0.12)}),
  ingles({x: 1000, y: 1730, scale: 1.2, expr: 'serio', look: -1, idle: {dur: d}, walk: {dur: 0.9, period: 0.4, stride: 18}, move: [{t: 0, x: 1200}, {t: 0.9, x: 860}, {t: d, x: 860}], armL: {shoulder: 80, elbow: 30, hold: [esposas({x: -10, y: 60, scaleX: 0.6, scaleY: 0.6})]}})],
  d, move.handheld(d, 8, 1.06), 640, 1300)]);
// 19.66–21.45 · «Los americanos mandan soldados.» — columna de soldados con bandera; el granjero respira.
shot(19.66, 21.45, d => [camF([...isla(d), asta(usFlag({}, 200), {x: 250, y: 1640, h: 560, dur: d}),
  ...fila(US, 4, 330, 190, 1730, 0.85, d, {look: 1, walk: 380, expr: 'contento'}),
  granjero({x: 1020, y: 1730, scale: 1.0, expr: 'contento', look: -1, idle: {dur: d}, move: hop(d, 1020, 1730, [0.9, 1.3], 50), headKeys: nod(d, [1.0], 7)})], d, move.travelling(d, 140, 1.08), 640, 1300)]);
// 21.45–23.06 · «Los británicos, barcos.» — tres buques entran en la bahía; fogonazo.
shot(21.45, 23.06, d => [camF([...mar(d),
  barco({x: 900, y: 1300, scale: 0.55, dur: d, flip: true, move: [{t: 0, x: 1500}, {t: 0.9, x: 900}, {t: d, x: 900}]}),
  barco({x: 420, y: 1560, scale: 0.8, dur: d, move: [{t: 0, x: -400}, {t: 0.8, x: 420}, {t: d, x: 420}]}),
  barco({x: 1000, y: 1850, scale: 1.0, dur: d, flip: true, move: [{t: 0, x: 1800}, {t: 0.7, x: 1000}, {t: d, x: 1000}]}),
  humo(1000, 1700, 1.0, d)], d, move.handheld(d, 9, 1.08), 640, 1300), tag('ROYAL NAVY', 420, 62, {t0: 0.2, tilt: 2})]);
// 23.06–26.34 · «Al mando, George Pickett. [beat] Sí, el de Gettysburg.» — Pickett saluda; luego el Becario y el cartel de 1863.
shot(23.06, 26.34, d => [camF([...isla(d), asta(usFlag({}, 200), {x: 1000, y: 1640, h: 560, dur: d}),
  soldadoUS(2, {x: 560, y: 1770, scale: 1.35, expr: 'contento', look: 0, idle: {dur: d}, talk: mouth(23.06, 26.34), gestures: [{t0: 0.4, t1: 1.5, arm: 'R', shoulder: 160, elbow: 95}], headKeys: nod(d, [0.5, 2.2], 6, 0.15)})],
  d, move.dolly(d, 1.0, 1.12), 640, 1300),
  G([tag('GEORGE PICKETT · EJÉRCITO DE EE. UU.', 420, 48, {t0: 0.05, tilt: -2})], {to: 1.7}),
  G([tag('1863: LA CARGA DE PICKETT', 420, 56, {t0: 1.75, tilt: 2})], {from: 1.7}),
  becCam(1.9, d, 'sarcastico', {x: 200, y: 560, s: 0.8})]);
// 26.34–28.91 · «Llega un almirante británico, mira aquello…» — el almirante entra, mira a un lado y a otro.
shot(26.34, 28.91, d => [camF([...isla(d), ...fila(US, 2, 70, 80, 1560, 0.45, d, {look: 1}), tienda('#e8dcc8', {x: 230, y: 1500, scaleX: 0.9, scaleY: 0.9}),
  barco({x: 1000, y: 1250, scale: 0.4, dur: d, flip: true}),
  almirante({x: 700, y: 1770, scale: 1.3, expr: 'serio', look: -1, idle: {dur: d}, talk: mouth(26.34, 28.91), walk: {dur: 0.8, period: 0.45, stride: 18}, move: [{t: 0, x: 1100}, {t: 0.8, x: 700}, {t: d, x: 700}], headKeys: [{t: 0, angle: 0}, {t: 1.0, angle: 0}, {t: 1.3, angle: deg(-8)}, {t: 1.9, angle: deg(8)}, {t: d, angle: deg(8)}]})],
  d, move.orbit(d, 60, 2, 1.1), 640, 1300), tag('ALMIRANTE BAYNES', 420, 62, {t0: 0.3, tilt: -2})]);
// 28.91–31.44 · «y se niega a una guerra por un cerdo.» — brazos cruzados, niega con la cabeza; el cerdo caído detrás.
shot(28.91, 31.44, d => [camF([...isla(d), cerdo({x: 280, y: 1830, scale: 0.9, dead: true}),
  almirante({x: 780, y: 1770, scale: 1.4, expr: 'serio', look: -1, idle: {dur: d}, talk: mouth(28.91, 31.44), armL: {shoulder: 95, elbow: 120}, armR: {shoulder: 95, elbow: 120}, headKeys: laugh(d, 0.4, 2.0, 9, 0.3)})],
  d, move.dolly(d, 1.0, 1.1), 640, 1300), slam('NO', 280, 900, 190, 0.5, d, {outline: true, color: RED, tilt: -8, stamp: true, from: 1.2})]);
// 31.44–35.01 · «Acaban compartiendo la isla doce años, armados y sin un tiro.» — dos campamentos frente a frente; los años pasan.
const YR = n => G([R(-170, -46, 340, 92, {radius: 12, fill: '#fff6d6', stroke: RED, lineWidth: 8}), ctext(`AÑO ${n}`, 0, -30, 52, {maxW: 300, color: RED})], {x: 640, y: 640});
shot(31.44, 35.01, d => [camF([...isla(d), tienda('#e8dcc8', {x: 130, y: 1530}), tienda('#e8dcc8', {x: 1150, y: 1530}), asta(usFlag({}, 180), {x: 260, y: 1560, h: 400, dur: d}), asta(ukFlag({}, 180), {x: 1020, y: 1560, h: 400, dur: d}),
  ...fila(US, 3, 300, 100, 1700, 0.7, d, {look: 1, expr: 'serio'}), ...fila(UK, 3, 740, 100, 1700, 0.7, d, {look: -1, expr: 'serio'})],
  d, move.pan(d, 120, 1.08), 640, 1300),
  ...Array.from({length: 12}, (_, k) => { const a = r3(0.1 + k * 0.27); return G([YR(k + 1)], {from: a, to: k < 11 ? r3(a + 0.27) : undefined}); })]);
// 35.01–38.08 · «Hasta que el káiser decide: para Estados Unidos.» — el káiser sella el laudo.
shot(35.01, 38.08, d => [camF([...office(d), desk(),
  kaiser({x: 360, y: GROUND + 40, scale: 1.15, expr: 'serio', look: 1, idle: {dur: d}, talk: mouth(35.01, 38.08), armR: {shoulder: 60, elbow: 70}, gestures: [{t0: 1.7, t1: 2.3, arm: 'R', shoulder: 140, elbow: 20}], headKeys: nod(d, [1.9], 8)}),
  G([laudo()], {x: 880, y: 1020, scaleX: 0.8, scaleY: 0.8, angle: deg(-3)})], d, move.dolly(d, 1.0, 1.1), 760, 1000), tag('ALEMANIA · 1872 · EL ÁRBITRO', 420, 48, {t0: 0.1, tilt: -2}), flash(1.95, 0.1, PAPER, 0.5)]);
// 38.08–41.37 · «Bajas militares: cero. El cerdo, una.» — los dos ejércitos intactos, saludando; aparece la lápida del cerdo.
shot(38.08, 41.37, d => [camF([...isla(d), asta(usFlag({}, 170), {x: 90, y: 1520, h: 420, dur: d}), asta(ukFlag({}, 170), {x: 1190, y: 1520, h: 420, dur: d}),
  ...fila(US, 3, 130, 120, 1650, 0.7, d, {look: 1, hopAt: [0.4]}), ...fila(UK, 3, 780, 120, 1650, 0.7, d, {look: -1, hopAt: [0.4]}),
  G([lapida()], {x: 640, y: 1760, scaleX: 1.0, scaleY: 1.0, from: 1.55, keys: sample(t => ({s: mix(1.8, 1, eBack((t - 1.55) / 0.2))}), 1.55, d)})],
  d, move.dolly(d, 1.0, 1.1), 640, 1300)]);
// 41.37–VOICE · «Por él pedían cien dólares; por mí, ni diez: doscientos veinticinco días sin cobrar.» — el Becario con el billete y el contador.
const counter = (n, o = {}) => G([R(-210, -46, 420, 92, {radius: 10, fill: '#fff6d6', stroke: RED, lineWidth: 8}), ctext(`DÍAS SIN COBRAR: ${n}`, 0, -30, 40, {maxW: 380, color: RED})], o);
shot(41.37, VOICE, d => [camF([...office(d), desk(),
  becario({x: 330, y: GROUND + 40, scale: 1.15, expr: 'cansado', look: 1, idle: {dur: d}, talk: mouth(41.37, VOICE), armR: {shoulder: 70, elbow: 120, hold: [billete(100, {x: 30, y: 110, scaleX: 0.55, scaleY: 0.55})]}, armL: {shoulder: 40, elbow: 60},
    gestures: [{t0: 2.2, t1: 3.2, arm: 'L', shoulder: 110, elbow: 30}], headKeys: [{t: 0, angle: 0}, {t: 2.4, angle: 0}, {t: 2.7, angle: deg(-4)}, {t: 4.1, angle: deg(-4)}, {t: 4.4, angle: deg(10)}, {t: d, angle: deg(10)}]}),
  counter(DAYS, {x: 640, y: 560, scaleX: 1.4, scaleY: 1.4, from: 3.0, keys: sample(t => ({s: 1.4 * mix(1.3, 1, eBack((t - 3.0) / 0.2))}), 3.0, d)}),
], d, move.dolly(d, 1.06, 1.16), 760, 1000)]);
// VOICE–END · Bucle: de la oficina a la miniatura; termina EXACTAMENTE en el fotograma 1.
shot(VOICE, END, d => [camF(hookSet(d, {hops: []}), d, t => ({s: mix(1.6, 1.0, eOut(t / (d - 0.04)))}), 640, 1300), flash(0, 0.1, PAPER, 0.8), thumb(d, 0.12, r3(d - 0.16))]);

// Transiciones: barrido rápido en los cortes que cambian de escenario.
const SAME = new Set([1.45, 3.1, 9.28, 10.78, 12.15, 13.64, 17.66, 19.66, 23.06, 28.91, 38.08]);
const whip = (dir, d) => G(Array.from({length: 9}, (_, i) => R(0, 120 + i * 230 + (i % 3) * 40, 900 + (i % 4) * 200, 34 + (i % 3) * 14, {radius: 17, fill: PAPER, stroke: 'none'})),
  {to: Math.min(d, 0.18), keys: sample(t => ({x: dir * mix(1400, -2400, t / 0.18), alpha: 0.75 * (1 - t / 0.18)}), 0, Math.min(d, 0.18))});
shots.forEach((sh, i) => { if (i && !SAME.has(sh.start)) sh.layers.push(whip(i % 2 ? 1 : -1, sh.end - sh.start)); });
// Subtítulos karaoke (captions.json = voz.py caps … --skip 0 --max 20).
const captions = JSON.parse(fs.readFileSync('captions.json', 'utf8'));
const cap = captionTrack(WORDS, captions, {num: RED, size: 76});
for (const s of shots) s.layers.push(...cap(s.start, s.end));
// Efectos: solo en silencios medidos o muy bajos. Ganancia máx. 1; ambientes ≤ 0,2; whoosh ≤ 0,25.
const has = n => fs.existsSync(`sfx/${n}.wav`);
const sfx = [
  F(0.12, 'cascos', 0.12, 0.4),
  F(4.18, 'whoosh', 0.2),
  F(10.3, 'canon', 0.3, 0.4),
  F(14.66, 'whoosh', 0.2),
  F(21.56, 'whoosh', 0.2, 0.25),
  F(21.8, 'cascos', 0.1, 0.4),
  F(36.72, 'stamp', 0.3, 0.3),
  F(41.2, 'crickets', 0.6, 0.35),
  F(46.75, 'whoosh', 0.2),
].filter(s => has(s.path.slice(4, -4)));
// Saneado: keys/from/to fuera del plano se recortan al plano.
const clip = (n, sp) => { if (!n || typeof n !== 'object') return n;
  if (n.keys) { const k = n.keys.filter(x => x.t >= 0 && x.t <= sp + 1e-9); n.keys = k.length ? k : [{...n.keys[0], t: 0}]; }
  if (n.to !== undefined && n.to > sp) n.to = r3(sp);
  if (n.children) n.children = n.children.filter(c => !(c && c.from !== undefined && c.from >= sp)).map(c => clip(c, sp));
  return n; };
for (const s of shots) { const sp = r3(s.end - s.start); s.layers = s.layers.filter(l => l && !(l.from !== undefined && l.from >= sp)).map(l => clip(l, sp)); }
fs.writeFileSync('project.json', JSON.stringify({version: 1, style: 'B3', width: 1080, height: 1920, fps: 30, voice: {path: 'narration.mp3', lead: 0, tail: r3(END - VOICE)}, television: {enabled: false},
  ...(fs.existsSync('music-duck.wav') ? {music: {path: 'music-duck.wav', gain: 0.2}} : {}), burnCaptions: false, captions, shots, sfx}, null, 1));
console.log('shots', shots.length, 'end', END, 'DAYS', DAYS);
