[
 {
  "start": 0.13,
  "end": 1.22,
  "text": "Seis barcos contra"
 },
 {
  "start": 1.23,
  "end": 2.43,
  "text": "más de cien."
 },
 {
  "start": 2.51,
  "end": 2.82,
  "text": "¡Hundan"
 },
 {
  "start": 2.83,
  "end": 3.86,
  "text": "los nuestros!"
 },
 {
  "start": 3.87,
  "end": 4.32,
  "text": "¿Perdón,"
 },
 {
  "start": 4.33,
  "end": 5.12,
  "text": "almirante?"
 },
 {
  "start": 5.13,
  "end": 6.26,
  "text": "¿Los nuestros?"
 },
 {
  "start": 6.27,
  "end": 6.78,
  "text": "En la entrada"
 },
 {
  "start": 6.79,
  "end": 7.64,
  "text": "de la bahía,"
 },
 {
  "start": 7.65,
  "end": 8.87,
  "text": "que les estorben."
 },
 {
  "start": 9.03,
  "end": 9.92,
  "text": "Se llama Blas"
 },
 {
  "start": 9.93,
  "end": 10.72,
  "text": "de Lezo."
 },
 {
  "start": 10.73,
  "end": 11.32,
  "text": "Cojo,"
 },
 {
  "start": 11.33,
  "end": 12.54,
  "text": "tuerto y manco."
 },
 {
  "start": 12.55,
  "end": 13.4,
  "text": "Unos cuatro mil"
 },
 {
  "start": 13.41,
  "end": 14.12,
  "text": "hombres."
 },
 {
  "start": 14.13,
  "end": 14.86,
  "text": "Delante,"
 },
 {
  "start": 14.87,
  "end": 15.62,
  "text": "Vernon,"
 },
 {
  "start": 15.63,
  "end": 16.79,
  "text": "veinte mil."
 },
 {
  "start": 16.83,
  "end": 17.44,
  "text": "Y un secreto"
 },
 {
  "start": 17.45,
  "end": 18.38,
  "text": "en Londres."
 },
 {
  "start": 18.39,
  "end": 19.36,
  "text": "Dos barcos se hunden"
 },
 {
  "start": 19.37,
  "end": 20.38,
  "text": "en Bocachica."
 },
 {
  "start": 20.39,
  "end": 21.76,
  "text": "Otro lo queman."
 },
 {
  "start": 21.77,
  "end": 22.52,
  "text": "Y los ingleses"
 },
 {
  "start": 22.53,
  "end": 23.6,
  "text": "entran igual."
 },
 {
  "start": 23.61,
  "end": 24.62,
  "text": "Almirante,"
 },
 {
  "start": 24.63,
  "end": 25.68,
  "text": "han pasado."
 },
 {
  "start": 25.69,
  "end": 26.52,
  "text": "Ya lo veo."
 },
 {
  "start": 26.53,
  "end": 27.46,
  "text": "El plan tenía letra"
 },
 {
  "start": 27.47,
  "end": 28.36,
  "text": "pequeña."
 },
 {
  "start": 28.37,
  "end": 29.16,
  "text": "Aun así,"
 },
 {
  "start": 29.17,
  "end": 30.06,
  "text": "resiste."
 },
 {
  "start": 30.07,
  "end": 30.98,
  "text": "Una madrugada"
 },
 {
  "start": 30.99,
  "end": 32.4,
  "text": "asaltan San Felipe"
 },
 {
  "start": 32.41,
  "end": 33.4,
  "text": "y fracasan."
 },
 {
  "start": 33.41,
  "end": 34.84,
  "text": "Seiscientas bajas."
 },
 {
  "start": 34.85,
  "end": 35.78,
  "text": "Llega la fiebre."
 },
 {
  "start": 35.79,
  "end": 36.54,
  "text": "Mueren miles"
 },
 {
  "start": 36.55,
  "end": 37.38,
  "text": "de ingleses."
 },
 {
  "start": 37.39,
  "end": 38.26,
  "text": "Tras más de dos"
 },
 {
  "start": 38.27,
  "end": 38.9,
  "text": "meses,"
 },
 {
  "start": 38.91,
  "end": 39.7,
  "text": "se van."
 },
 {
  "start": 39.71,
  "end": 40.68,
  "text": "Entonces,"
 },
 {
  "start": 40.69,
  "end": 41.74,
  "text": "¿hemos ganado?"
 },
 {
  "start": 41.75,
  "end": 42.42,
  "text": "Espera."
 },
 {
  "start": 42.43,
  "end": 43.08,
  "text": "Mira el secreto"
 },
 {
  "start": 43.09,
  "end": 44.03,
  "text": "de Vernon."
 },
 {
  "start": 44.05,
  "end": 44.92,
  "text": "Medallas."
 },
 {
  "start": 44.93,
  "end": 45.54,
  "text": "Vernon,"
 },
 {
  "start": 45.55,
  "end": 46.22,
  "text": "de pie."
 },
 {
  "start": 46.23,
  "end": 47.0,
  "text": "Y Lezo,"
 },
 {
  "start": 47.01,
  "end": 47.9,
  "text": "de rodillas,"
 },
 {
  "start": 47.91,
  "end": 48.54,
  "text": "entregándole"
 },
 {
  "start": 48.55,
  "end": 49.38,
  "text": "la espada."
 },
 {
  "start": 49.39,
  "end": 50.48,
  "text": "Las acuñaron antes"
 },
 {
  "start": 50.49,
  "end": 51.3,
  "text": "de ganar."
 },
 {
  "start": 51.31,
  "end": 52.52,
  "text": "Y no ganaron."
 },
 {
  "start": 52.53,
  "end": 53.1,
  "text": "Una victoria"
 },
 {
  "start": 53.11,
  "end": 54.12,
  "text": "imaginaria,"
 },
 {
  "start": 54.13,
  "end": 55.24,
  "text": "como mi nómina."
 },
 {
  "start": 55.25,
  "end": 55.86,
  "text": "Doscientos"
 },
 {
  "start": 55.87,
  "end": 56.8,
  "text": "veintinueve días"
 },
 {
  "start": 56.81,
  "end": 57.8,
  "text": "sin cobrar"
 }
]