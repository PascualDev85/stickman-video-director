[
 {
  "start": 0.19,
  "end": 1.32,
  "text": "Seis barcos contra"
 },
 {
  "start": 1.33,
  "end": 2.56,
  "text": "más de cien."
 },
 {
  "start": 2.57,
  "end": 2.9,
  "text": "¡Hundan"
 },
 {
  "start": 2.91,
  "end": 3.98,
  "text": "los nuestros!"
 },
 {
  "start": 3.99,
  "end": 4.38,
  "text": "¿Perdón,"
 },
 {
  "start": 4.39,
  "end": 5.16,
  "text": "almirante?"
 },
 {
  "start": 5.17,
  "end": 6.26,
  "text": "¿Los nuestros?"
 },
 {
  "start": 6.27,
  "end": 6.8,
  "text": "En la entrada"
 },
 {
  "start": 6.81,
  "end": 7.66,
  "text": "de la bahía,"
 },
 {
  "start": 7.67,
  "end": 8.89,
  "text": "que les estorben."
 },
 {
  "start": 8.95,
  "end": 9.78,
  "text": "Se llama Blas"
 },
 {
  "start": 9.79,
  "end": 10.6,
  "text": "de Lezo."
 },
 {
  "start": 10.61,
  "end": 11.16,
  "text": "Cojo,"
 },
 {
  "start": 11.17,
  "end": 12.38,
  "text": "tuerto y manco."
 },
 {
  "start": 12.39,
  "end": 13.34,
  "text": "Tiene unos tres mil"
 },
 {
  "start": 13.35,
  "end": 14.0,
  "text": "hombres."
 },
 {
  "start": 14.01,
  "end": 14.7,
  "text": "Delante,"
 },
 {
  "start": 14.71,
  "end": 15.2,
  "text": "Vernon,"
 },
 {
  "start": 15.21,
  "end": 15.96,
  "text": "con más de veinte"
 },
 {
  "start": 15.97,
  "end": 16.54,
  "text": "mil."
 },
 {
  "start": 16.55,
  "end": 17.52,
  "text": "Dos barcos se hunden"
 },
 {
  "start": 17.53,
  "end": 18.5,
  "text": "en Bocachica."
 },
 {
  "start": 18.51,
  "end": 19.84,
  "text": "Otro lo queman."
 },
 {
  "start": 19.85,
  "end": 20.66,
  "text": "Y los ingleses"
 },
 {
  "start": 20.67,
  "end": 21.82,
  "text": "entran igual."
 },
 {
  "start": 21.83,
  "end": 22.8,
  "text": "Almirante,"
 },
 {
  "start": 22.81,
  "end": 23.86,
  "text": "han pasado."
 },
 {
  "start": 23.87,
  "end": 24.76,
  "text": "Ya lo veo."
 },
 {
  "start": 24.77,
  "end": 25.76,
  "text": "El plan tenía letra"
 },
 {
  "start": 25.77,
  "end": 26.6,
  "text": "pequeña."
 },
 {
  "start": 26.61,
  "end": 27.42,
  "text": "Aun así,"
 },
 {
  "start": 27.43,
  "end": 28.24,
  "text": "resiste."
 },
 {
  "start": 28.25,
  "end": 29.04,
  "text": "Una madrugada,"
 },
 {
  "start": 29.05,
  "end": 30.16,
  "text": "los ingleses asaltan"
 },
 {
  "start": 30.17,
  "end": 30.9,
  "text": "el fuerte de San"
 },
 {
  "start": 30.91,
  "end": 32.64,
  "text": "Felipe y fracasan."
 },
 {
  "start": 32.65,
  "end": 33.64,
  "text": "Unas seiscientas"
 },
 {
  "start": 33.65,
  "end": 34.4,
  "text": "bajas."
 },
 {
  "start": 34.41,
  "end": 35.58,
  "text": "Pasan las semanas,"
 },
 {
  "start": 35.59,
  "end": 36.56,
  "text": "llega la fiebre,"
 },
 {
  "start": 36.57,
  "end": 37.32,
  "text": "mueren miles"
 },
 {
  "start": 37.33,
  "end": 38.22,
  "text": "de ingleses."
 },
 {
  "start": 38.23,
  "end": 38.9,
  "text": "Después de más"
 },
 {
  "start": 38.91,
  "end": 39.82,
  "text": "de dos meses,"
 },
 {
  "start": 39.83,
  "end": 40.68,
  "text": "se van."
 },
 {
  "start": 40.69,
  "end": 41.64,
  "text": "Entonces,"
 },
 {
  "start": 41.65,
  "end": 42.7,
  "text": "¿hemos ganado?"
 },
 {
  "start": 42.71,
  "end": 43.42,
  "text": "Espera,"
 },
 {
  "start": 43.43,
  "end": 44.08,
  "text": "mira lo que habían"
 },
 {
  "start": 44.09,
  "end": 45.32,
  "text": "hecho en Inglaterra."
 },
 {
  "start": 45.33,
  "end": 46.3,
  "text": "Medallas."
 },
 {
  "start": 46.31,
  "end": 46.86,
  "text": "Vernon,"
 },
 {
  "start": 46.87,
  "end": 47.52,
  "text": "de pie,"
 },
 {
  "start": 47.53,
  "end": 48.34,
  "text": "y Lezo,"
 },
 {
  "start": 48.35,
  "end": 49.26,
  "text": "de rodillas,"
 },
 {
  "start": 49.27,
  "end": 49.9,
  "text": "entregándole"
 },
 {
  "start": 49.91,
  "end": 50.74,
  "text": "la espada."
 },
 {
  "start": 50.75,
  "end": 51.88,
  "text": "Las acuñaron antes"
 },
 {
  "start": 51.89,
  "end": 52.74,
  "text": "de ganar."
 },
 {
  "start": 52.75,
  "end": 53.98,
  "text": "Y no ganaron."
 },
 {
  "start": 53.99,
  "end": 54.56,
  "text": "Una victoria"
 },
 {
  "start": 54.57,
  "end": 55.56,
  "text": "imaginaria,"
 },
 {
  "start": 55.57,
  "end": 56.6,
  "text": "como mi nómina."
 },
 {
  "start": 56.61,
  "end": 57.3,
  "text": "Doscientos"
 },
 {
  "start": 57.31,
  "end": 58.28,
  "text": "veintinueve días"
 },
 {
  "start": 58.29,
  "end": 59.26,
  "text": "sin cobrar"
 }
]