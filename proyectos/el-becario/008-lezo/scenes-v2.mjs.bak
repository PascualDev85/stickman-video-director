// EXPEDIENTE 008 — «Blas de Lezo en Cartagena de Indias» (Historias Sin Cabeza). Short 9:16, ~59 s (final a ×1,2 ≈ 49 s).
// Guion v2 (18-nov-2026), toma A de ElevenLabs sin recortar. Tiempos = words.json (Scribe).
// v2 (21-nov): los personajes del siglo XVIII NO mueven los labios (narra el Becario); el Becario narra en ventanita
// (con boca sincronizada) y reacciona; planos ≤ 2,6 s, fondos variados, portada y bucle, gags.
// Publica: miércoles 25-nov-2026 · contador 229 (PUB/DAYS).
import fs from 'node:fs';
import {becario, almirante, casaca, soldadoDe, lezo, vernon, E, R, G, P, S, deg, INK, PAPER, ctext, sign} from '../kit.mjs';
import {GROUND, RED, YEL, tag, captionTrack, layout, fill, band, lin, mix, r3, eOut, eInOut, eBack, shake, sample, camF, cam, slam, popIn, flash, rays, office, emptyWallet, makeEpisode, F} from '../lib.mjs';
import {ukFlag} from '../006-guerra-cerdo/props.mjs';
import {mar, agua, barcoX, fuerte, tumba, medalla, plan, sudor, cabina, ciudad, bigBen, escalera, grietas, trofeo, lupa} from './props.mjs';

const {WORDS, shots, shot, mouth} = makeEpisode('words.json');
layout.titleDY = 0;
const VOICE = 59.12, END = 59.4; // VOICE = duración real de narration.mp3
const DAYS = 229; // contador «DÍAS SIN COBRAR» (PUB = mié 25-nov-2026)
const NAVY = '#1f3a6e';
const FY = GROUND + 120; // pies de los personajes
const sh = (a, b, f) => shot(a, b, d => f(d, a, b));

// ---------- utilidades ----------
const cubierta = () => [band(GROUND + 80, 900, '#9a6a3c'), band(GROUND + 80, 10, '#5a3a1e'), ...[0, 1, 2, 3].map(i => P([['M', 100 + i * 330, GROUND + 160], ['L', 260 + i * 330, GROUND + 160]], {stroke: '#7d5229', lineWidth: 6}))];
const tierra = (c = '#b5a07a') => [band(GROUND + 80, 900, c), band(GROUND + 80, 10, '#6b5a3a')];
const noche = d => [fill('#141a36'), band(820, 400, '#1f2650'), ...[[120, 520], [300, 620], [520, 480], [760, 600], [880, 470], [1180, 560], [420, 760]].map(([x, y], i) => E(x, y, 10, 10, {fill: '#fff6c8', stroke: 'none', keys: sample(t => ({alpha: 0.65 + 0.35 * Math.sin(t * (1.4 + i * 0.2))}), 0, d)})), E(1040, 380, 130, 130, {fill: '#f4f1d0', lineWidth: 8})];
const counter = (n, o = {}) => G([R(-210, -46, 420, 92, {radius: 10, fill: '#fff6d6', stroke: RED, lineWidth: 8}), ctext(`DÍAS SIN COBRAR: ${n}`, 0, -30, 40, {maxW: 380, color: RED})], o);
const fila = (fn, n, x0, dx, y, s, extra = () => ({})) => Array.from({length: n}, (_, i) => fn(i, {x: x0 + i * dx, y: y + (i % 2) * 14, scale: s, ...extra(i)}));
const pop = (layer, x, y, t0, d, until) => G([popIn(layer, t0, d, 0.22, until)], {x, y, ...(until ? {from: t0, to: until} : {})}); // pop-in centrado en (x, y)
/** Cabeceo en los instantes ts (reacción de los personajes: ellos NO hablan, narra el Becario). */
const nod = (d, ts, amp = 6) => [{t: 0, angle: 0}, ...ts.filter(t => t + 0.2 < d).flatMap(t => [{t: r3(t), angle: deg(amp)}, {t: r3(t + 0.2), angle: 0}])];
/** Becario en ventanita, narrando con la boca sincronizada (voz de [a, b]) y reaccionando. */
const becCam = (t0, d, expr, a, b, {x = 200, y = 720, look = 1, s: sc = 1} = {}) => G([R(-170, -235, 340, 470, {radius: 24, fill: '#e8e2d0', lineWidth: 10}), R(-120, -200, 110, 150, {radius: 4, fill: '#c9d6e3', lineWidth: 6}),
  becario({x: 0, y: 440, scale: 0.85, expr, look, bust: true, idle: {dur: d}, talk: mouth(a, b), headKeys: [{t: 0, angle: 0}, {t: r3(t0 + 0.25), angle: 0}, {t: r3(t0 + 0.4), angle: deg(-6 * look)}, {t: d, angle: deg(-6 * look)}]}),
  R(-170, 150, 340, 85, {radius: 0, fill: '#8a6a4a', lineWidth: 8}), R(-170, -235, 340, 470, {radius: 24, fill: 'none', lineWidth: 12})],
{x, y, from: r3(t0), keys: sample(t => ({s: sc * mix(0.3, 1, eBack((t - t0) / 0.2)), a: -3}), r3(t0), d)});

// Gancho / portada: rayos rojos, 6 barcos contra un bosque de barcos, Lezo pícaro y Vernon sonriendo.
const thumbCard = d => [...rays(d, '#9e1f17', '#d4473a', 640, 1250, 10, 16), band(1180, 1400, '#5fa3cf'), band(1180, 14, '#3a7aa8'),
  ...[0, 1, 2].flatMap(r => Array.from({length: 6}, (_, i) => barcoX({x: 560 + i * 120 + (r % 2) * 50, y: 1240 + r * 90, scale: 0.27, flag: 'uk', flip: true, dur: d}))),
  ...Array.from({length: 6}, (_, i) => barcoX({x: 90 + i * 62, y: 1500 + (i % 2) * 24, scale: 0.26, flag: 'es', dur: d})),
  lezo({x: 300, y: 2080, scale: 1.55, bust: true, expr: 'picaro', look: 1, idle: {dur: d}}), vernon({x: 1000, y: 2080, scale: 1.25, bust: true, expr: 'contento', look: -1, idle: {dur: d}})];
const thumbTitle = () => { const line = (text, y, size, color) => ({...ctext(text, 600, y, size, {maxW: 880, color}), outline: INK, outlineWidth: 22});
  return G([G([tag('HISTORIA REAL · 1741', 330, 46, {pop: false, color: RED, tilt: -2})], {x: -40}), G([line('SEIS BARCOS', 440, 160, YEL), line('CONTRA +100', 620, 140, PAPER)], {angle: deg(-3)})]); };

// ================= PLANOS =================
// 0–2.57 · «Seis barcos contra más de cien.» — portada (frame 0 = miniatura)
sh(0, 2.57, d => [camF(thumbCard(d), d, t => ({s: mix(1.0, 1.06, t / d)}), 640, 1300), thumbTitle()]);
// 2.57–3.99 · «¡Hundan los nuestros!»
sh(2.57, 3.99, (d, a, b) => [camF([...mar(d, {sky: '#f6d9a8'}), ...fila((i, o) => barcoX({...o, flag: 'es', dur: d}), 3, 280, 330, 1130, 0.32), ...cubierta(),
  lezo({x: 780, y: FY + 30, scale: 1.45, expr: 'serio', idle: {dur: d}, gestures: [{t0: 0.15, t1: d - 0.05, arm: 'R', shoulder: 100, elbow: 5}], headKeys: nod(d, [0.3, 0.9], 5)}), flash(0, 0.1, '#ffffff', 0.7)],
d, t => ({s: mix(1.08, 1.2, t / d), ...shake(t, 0, 0.4, 14)}), 640, 1000), becCam(0.45, d, 'sorpresa', a, b)]);
// 3.99–6.27 · «¿Perdón, almirante? ¿Los nuestros?» — camarote, el oficial confuso
sh(3.99, 6.27, d => [cam([...cabina(d),
  almirante({x: 560, y: FY, scale: 1.2, expr: 'sorpresa', look: 1, idle: {dur: d}, headKeys: nod(d, [0.4, 1.3], 7)}), lezo({x: 960, y: FY, scale: 1.2, expr: 'serio', look: -1, idle: {dur: d}}),
  pop(ctext('?', 0, -90, 150, {color: RED}), 520, 520, 0.5, d), pop(ctext('?', 0, -90, 110, {color: RED}), 640, 470, 1.2, d), sudor(500, 700, 0.8)], d, 1.0, 1.08)]);
// 6.27–8.89 · «En la entrada de la bahía. Que les estorben.»
sh(6.27, 8.89, d => [cam([...mar(d), ...fila((i, o) => barcoX({...o, flag: 'es', dur: d, sink: {t0: 1.0 + i * 0.3, len: 1.0, depth: 120, tilt: 0.25 * (i % 2 ? -1 : 1)}}), 3, 380, 250, 1130, 0.3),
  ...agua(1150), G([lezo({x: 190, y: FY, scale: 0.9, expr: 'serio', idle: {dur: d}})]), slam('HUNDIRSE VOLUNTARIAMENTE', 600, 700, 42, 1.4, d, {stamp: true, color: RED, tilt: -4, maxW: 700})], d, 1.0, 1.06)]);
// 8.89–10.6 · «Se llama Blas de Lezo.»
sh(8.89, 10.6, d => [camF([...rays(d, '#cfe3f7', '#e6f1fb', 640, 1100, 12, 12), lezo({x: 640, y: FY + 40, scale: 1.4, expr: 'serio', idle: {dur: d}, headKeys: nod(d, [0.5], 5)})], d, t => ({s: mix(1.0, 1.15, eOut(t / d))}), 640, 900), tag('BLAS DE LEZO', 357, 80)]);
// 10.6–12.4 · «Cojo, tuerto y manco.»
sh(10.6, 12.4, d => [cam([...rays(d, '#cfe3f7', '#e6f1fb', 640, 1100, 12, 12), lezo({x: 640, y: FY + 40, scale: 1.35, expr: 'serio', idle: {dur: d}}),
  pop(sign('COJO', -150, -55, 300, 110, {size: 70, color: RED}), 450, 1555, 0.05, d), pop(sign('TUERTO', -180, -55, 360, 110, {size: 70, color: RED}), 780, 755, 0.62, d), pop(sign('MANCO', -155, -55, 310, 110, {size: 70, color: RED}), 480, 1105, 1.18, d)], d, 1.0, 1.05)]);
// 12.4–14.0 · «Tiene unos tres mil hombres.»
sh(12.4, 14.0, d => [cam([fill('#e8dcc0'), ...tierra(), ...fila((i, o) => soldadoDe(1 + (i % 2), {...o, expr: 'serio', idle: {dur: d}}), 7, 200, 140, FY, 0.42), slam('≈ 3.000', 600, 700, 170, 0.1, d, {color: NAVY, outline: true})], d, 1.0, 1.06), tag('AL FINAL: LA MEDALLA', 357, 54, {t0: 0.3, color: RED})]);
// 14.0–15.21 · «Delante, Vernon,»
sh(14.0, 15.21, d => [cam([fill('#e8dcc0'), ...tierra('#a89a6a'), ...[0, 1].flatMap(r => fila((i, o) => casaca(1 + (i % 2), {...o, expr: 'serio', idle: {dur: d}}), 8, 90 + (r % 2) * 60, 150, FY - 260 + r * 90, 0.3)),
  vernon({x: 640, y: FY + 40, scale: 1.35, expr: 'picaro', idle: {dur: d}, headKeys: nod(d, [0.5], 5)})], d, 1.0, 1.08), tag('ALMIRANTE VERNON', 357, 76)]);
// 15.21–16.54 · «con más de veinte mil.»
sh(15.21, 16.54, d => [cam([fill('#e8dcc0'), ...tierra('#a89a6a'), ...[0, 1, 2].flatMap(r => fila((i, o) => casaca(1 + (i % 2), {...o, expr: 'serio', idle: {dur: d}}), 8, 90 + (r % 2) * 60, 150, FY - 300 + r * 90, 0.3)),
  vernon({x: 960, y: FY + 60, scale: 0.95, expr: 'contento', idle: {dur: d}}), slam('+ 20.000', 600, 620, 130, 0.1, d, {color: RED, outline: true})], d, 1.0, 1.06)]);
// 16.55–18.5 · «Dos barcos se hunden en Bocachica.»
sh(16.55, 18.5, d => [cam([...mar(d), barcoX({x: 380, y: 1120, scale: 0.5, flag: 'es', dur: d, sink: {t0: 0.3, len: 1.3, depth: 170, tilt: -0.3}}), barcoX({x: 880, y: 1120, scale: 0.5, flag: 'es', dur: d, sink: {t0: 0.6, len: 1.3, depth: 170, tilt: 0.3}}), ...agua(1150)], d, 1.0, 1.06), tag('BOCACHICA', 357, 84)]);
// 18.5–19.85 · «Otro lo queman.»
sh(18.5, 19.85, d => [cam([...mar(d, {sky: '#f2c9a0'}), barcoX({x: 640, y: 1130, scale: 0.75, flag: 'es', dur: d, fire: true}), ...agua(1150)], d, 1.0, 1.1)]);
// 19.85–21.82 · «Y los ingleses entran igual.» — barcos enormes pasan entre los mástiles hundidos
sh(19.85, 21.82, d => [cam([...mar(d), G([0, 1, 2].map(i => barcoX({x: 1500 - i * 420, y: 1100 + (i % 2) * 40, scale: 0.7, flag: 'uk', flip: true, dur: d})), {keys: lin(d, 0, -1500, 'x')}),
  barcoX({x: 260, y: 1210, scale: 0.4, flag: 'es', dur: d, sink: {t0: 0, len: 0.01, depth: 230, tilt: 0.2}}), ...agua(1170),
  vernon({x: 1000, y: FY + 60, scale: 1.0, expr: 'picaro', idle: {dur: d}, headKeys: nod(d, [0.5, 1.3], 6)}), slam('ENTRADA LIBRE', 600, 700, 66, 0.9, d, {color: RED, stamp: true, tilt: -4})], d, 1.0, 1.05)]);
// 21.83–23.86 · «Almirante, han pasado.» — barcos ingleses ENORMES al fondo
sh(21.83, 23.86, (d, a, b) => [cam([...mar(d), ...fila((i, o) => barcoX({...o, flag: 'uk', flip: true, dur: d}), 3, 200, 440, 1040, 1.0), ...cubierta(),
  almirante({x: 720, y: FY, scale: 1.15, expr: 'miedo', look: 1, idle: {dur: d}, headKeys: nod(d, [0.3, 1.0], 7)}), lezo({x: 1040, y: FY, scale: 1.15, expr: 'serio', look: -1, idle: {dur: d}}), sudor(680, 680, 0.5)], d, 1.0, 1.08), becCam(0.3, d, 'agobiado', a, b, {y: 1270})]);
// 23.87–24.76 · «Ya lo veo.»
sh(23.87, 24.76, d => [camF([...rays(d, '#e9e2cf', '#f4efe4', 640, 1100, 10, 12), lezo({x: 640, y: FY + 40, scale: 1.45, expr: 'sarcastico', idle: {dur: d}})], d, t => ({s: mix(1.0, 1.12, eOut(t / d))}), 640, 900)]);
// 24.76–26.61 · «El plan tenía letra pequeña.»
sh(24.76, 26.61, d => [camF([fill('#e9e2cf'), G([plan({})], {x: 640, y: 1000, scaleX: 1.2, scaleY: 1.2}), G([lupa({})], {x: 700, y: 1180, from: 0.9, keys: sample(t => ({s: mix(0.05, 1, eBack((t - 0.9) / 0.2))}), 0.9, d)}),
  ], d, t => ({s: mix(1.0, 1.25, eInOut(t / d))}), 640, 1100), slam('LETRA PEQUEÑA', 600, 560, 70, 1.0, d, {color: RED, stamp: true, tilt: -4, maxW: 760})]);
// 26.61–28.25 · «Aun así, resiste.» — Cartagena
sh(26.61, 28.25, d => [cam([...ciudad(d), ...tierra('#c9b48a'), fuerte({x: 330, y: GROUND + 60, scaleX: 1.1, scaleY: 1.1}), lezo({x: 940, y: FY, scale: 1.25, expr: 'serio', idle: {dur: d}, armL: {shoulder: 30, elbow: 90}, armR: {shoulder: 30, elbow: 90}, headKeys: nod(d, [0.5], 5)})], d, 1.0, 1.08)]);
// 28.25–30.17 · «Una madrugada, los ingleses asaltan» — noche, se acercan
sh(28.25, 30.17, d => [camF([...noche(d), ...tierra('#3a3a52'), fuerte({x: 640, y: GROUND + 60, scaleX: 1.2, scaleY: 1.2}),
  G(fila((i, o) => casaca(1 + (i % 2), {...o, expr: 'nervioso', idle: {dur: d}}), 5, 150, 250, FY + 30, 0.5), {keys: lin(d, -260, 0, 'x')})], d, t => ({s: mix(1.0, 1.1, t / d)}), 640, 1100), tag('MADRUGADA', 357, 70, {t0: 0.2})]);
// 30.17–31.82 · «el fuerte de San Felipe» — las escaleras son demasiado cortas (gag)
sh(30.17, 31.82, d => [camF([...noche(d), ...tierra('#3a3a52'), fuerte({x: 640, y: GROUND + 60, scaleX: 1.2, scaleY: 1.2}),
  G([escalera({}, 220)], {x: 450, y: GROUND + 60, angle: deg(8)}), G([escalera({}, 220)], {x: 830, y: GROUND + 60, angle: deg(-8)}),
  casaca(1, {x: 440, y: GROUND + 40 - 180, scale: 0.38, expr: 'nervioso', idle: {dur: d}}), casaca(2, {x: 840, y: GROUND + 40 - 180, scale: 0.38, expr: 'miedo', idle: {dur: d}}),
  pop(lezo({x: 0, y: 160, scale: 0.55, bust: true, expr: 'sarcastico', idle: {dur: d}}), 640, 1010, 0.9, d), pop(ctext('¿?', 0, -50, 90, {color: PAPER}), 640, 1230, 0.7, d)], d, t => ({s: mix(1.1, 1.0, t / d)}), 640, 1100), tag('SAN FELIPE', 357, 76)]);
// 31.82–32.65 · «y fracasan.»
sh(31.82, 32.65, d => [cam([...noche(d), ...tierra('#3a3a52'), fuerte({x: 640, y: GROUND + 60, scaleX: 1.2, scaleY: 1.2}),
  ...fila((i, o) => casaca(1 + (i % 2), {...o, expr: 'miedo', angle: deg(60 - i * 18)}), 4, 220, 250, FY + 90, 0.5), slam('FRACASAN', 600, 700, 130, 0.04, d, {color: RED, stamp: true, outline: true, tilt: -4}), flash(0, 0.1, PAPER, 0.7)], d, 1.0, 1.05)]);
// 32.65–34.4 · «Unas seiscientas bajas.»
sh(32.65, 34.41, d => [cam([fill('#e8dcc0'), ...tierra('#a89a6a'), ...fila((i, o) => tumba({x: o.x, y: o.y + 100, scaleX: 1.2, scaleY: 1.2}), 5, 160, 240, 1150), slam('600 BAJAS', 600, 640, 160, 0.9, d, {color: RED, outline: true})], d, 1.0, 1.06)]);
// 34.41–36.57 · «Pasan las semanas, llega la fiebre»
sh(34.41, 36.57, d => [cam([fill('#dfe9d2'), ...tierra('#a89a6a'), casaca(1, {x: 640, y: FY, scale: 1.3, expr: 'agobiado', idle: {dur: d}}), sudor(520, 560, 0.3), sudor(780, 580, 0.7), sudor(560, 580, 1.1),
  pop(sign('FIEBRE', -200, -60, 400, 120, {size: 80, color: '#2e6b4a'}), 640, 1160, 1.2, d)], d, 1.0, 1.1), tag('PASAN LAS SEMANAS', 357, 66)]);
// 36.57–38.23 · «mueren miles de ingleses»
sh(36.57, 38.23, d => [cam([fill('#cfd6dc'), ...tierra('#8f9aa6'), ...[0, 1, 2, 3, 4, 5].map(i => pop(tumba({x: 0, y: 0, scaleX: 1.1, scaleY: 1.1}), 130 + i * 200, 1250 + (i % 2) * 110, 0.1 + i * 0.18, d))], d, 1.0, 1.06), tag('MUEREN MILES', 357, 80)]);
// 38.23–40.69 · «Después de más de dos meses, se van.» — Lezo se despide con la mano
sh(38.23, 40.69, d => [cam([...ciudad(d), G([0, 1, 2].map(i => barcoX({x: 700 - i * 380, y: 1120 + (i % 2) * 40, scale: 0.5, flag: 'uk', dur: d})), {keys: lin(d, 0, 1100, 'x')}), ...agua(1170), ...tierra('#c9b48a'),
  lezo({x: 300, y: FY, scale: 0.9, expr: 'contento', idle: {dur: d}, gestures: [{t0: 0.5, t1: d - 0.05, arm: 'R', shoulder: 170, elbow: 20}]}), slam('+ 2 MESES', 600, 650, 120, 0.2, d, {color: NAVY, outline: true})], d, 1.0, 1.05)]);
// 40.69–42.71 · «Entonces, ¿hemos ganado?» — el oficial celebra; Lezo desconfía; el Becario ya sabe lo que viene
sh(40.69, 42.71, (d, a, b) => [cam([...ciudad(d), ...tierra('#c9b48a'), almirante({x: 560, y: FY, scale: 1.2, expr: 'contento', look: 1, idle: {dur: d}, gestures: [{t0: 0.3, t1: d - 0.05, arm: 'R', shoulder: 160, elbow: 30}], headKeys: nod(d, [0.3, 0.9, 1.5], 6)}),
  lezo({x: 960, y: FY, scale: 1.2, expr: 'sarcastico', look: -1, idle: {dur: d}}), pop(sign('¡VICTORIA!', -190, -60, 380, 120, {size: 76, color: '#2e6b4a'}), 640, 720, 0.4, d)], d, 1.0, 1.08), becCam(0.9, d, 'picaro', a, b)]);
// 42.71–45.33 · «Espera, mira lo que habían hecho en Inglaterra.» — el Becario narra en su oficina
sh(42.71, 45.33, (d, a, b) => [cam([...office(d), bigBen({x: 1000, y: 1060}), G([ukFlag({}, 420)], {x: 440, y: 560, keys: sample(t => ({angle: Math.sin(t * 3) * 0.04}), 0, d)}),
  becario({x: 640, y: FY, scale: 1.25, expr: 'sarcastico', look: 0, idle: {dur: d}, talk: mouth(a, b)})], d, 1.0, 1.08), tag('INGLATERRA', 357, 84)]);
// 45.33–46.31 · «Medallas.»
sh(45.33, 46.31, d => [camF([...rays(d, '#fff1b5', '#ffe36b', 640, 1000, 14, 14), G([medalla({})], {x: 640, y: 1000}), flash(0, 0.12, PAPER, 0.8)], d, t => ({s: mix(0.7, 1.0, eOut(t / 0.3))}), 640, 1000)]);
// 46.31–48.35 · «Vernon, de pie, y Lezo,»
sh(46.31, 48.35, d => [camF([...rays(d, '#fff1b5', '#ffe36b', 640, 1000, 14, 14), G([medalla({})], {x: 640, y: 1000})], d, t => ({s: mix(1.0, 2.2, eInOut(t / d)), x: mix(0, 220, eInOut(t / d))}), 640, 1000)]);
// 48.35–50.75 · «de rodillas, entregándole la espada.»
sh(48.35, 50.75, (d, a, b) => [camF([...rays(d, '#fff1b5', '#ffe36b', 640, 1000, 14, 14), G([medalla({})], {x: 640, y: 1000})], d, t => ({s: mix(2.2, 2.6, t / d), x: mix(220, -260, eInOut(t / d))}), 640, 1000),
  slam('¿PERO QUÉ…?', 600, 560, 88, 1.6, d, {color: RED, stamp: true, outline: true, tilt: 3, maxW: 700}), becCam(1.4, d, 'sorpresa', a, b, {x: 200, y: 1150})]);
// 50.75–52.75 · «Las acuñaron antes de ganar.»
sh(50.75, 52.75, d => [cam([...rays(d, '#fff1b5', '#ffe36b', 640, 1000, 14, 14), G([medalla({})], {x: 640, y: 1000, scaleX: 0.9, scaleY: 0.9}), slam('ANTES DE GANAR', 600, 400, 72, 0.9, d, {color: NAVY, stamp: true, outline: true, tilt: -4})], d, 1.0, 1.05)]);
// 52.75–53.99 · «Y no ganaron.»
sh(52.75, 53.99, (d, a, b) => [cam([...rays(d, '#fff1b5', '#ffe36b', 640, 1000, 14, 14), G([medalla({}), grietas({})], {x: 640, y: 1000, scaleX: 0.9, scaleY: 0.9, keys: sample(t => ({a: t > 0.1 ? Math.sin(t * 40) * 0.04 * Math.max(0, 1 - t / 0.5) : 0}), 0, d)}),
  slam('NO GANARON', 600, 1500, 96, 0.05, d, {color: RED, stamp: true, outline: true, tilt: 4}), flash(0, 0.12, PAPER, 0.6)], d, 1.0, 1.05), becCam(0.5, d, 'sarcastico', a, b)]);
// 53.99–56.61 · «Una victoria imaginaria, como mi nómina.»
sh(53.99, 56.61, (d, a, b) => [cam([...office(d), pop(G([E(0, 0, 360, 260, {fill: PAPER, lineWidth: 8}), trofeo({y: 20, scaleX: 1.1, scaleY: 1.1})]), 380, 620, 0.2, d),
  becario({x: 700, y: FY, scale: 1.25, expr: 'cansado', look: 0, idle: {dur: d}, talk: mouth(a, b), headKeys: [{t: 0, angle: deg(4)}, {t: 1.6, angle: deg(8)}, {t: d, angle: deg(8)}]})], d, 1.0, 1.08)]);
// 56.61–59.12 · «Doscientos veintinueve días sin cobrar.»
sh(56.61, VOICE, (d, a, b) => [camF([...office(d), counter(DAYS, {x: 640, y: 480, scaleX: 1.6, scaleY: 1.6}), emptyWallet(930, 1060, 0.3, d, 1.1),
  becario({x: 480, y: FY, scale: 1.25, expr: 'cansado', look: 1, idle: {dur: d}, talk: mouth(a, b), headKeys: [{t: 0, angle: deg(4)}, {t: d, angle: deg(-4)}]})], d, t => ({s: mix(1.0, 1.15, eInOut(t / d))}), 640, 1000)]);
// Bucle: vuelve al primer fotograma (la portada).
sh(VOICE, END, d => [camF(thumbCard(d), d, t => ({s: mix(1.1, 1.0, eOut(t / 0.2))}), 640, 1300), flash(0, 0.12, PAPER, 0.8), thumbTitle()]);

// Planos contiguos: el hueco de 0,01 s entre palabras se absorbe en el plano anterior.
for (let i = 1; i < shots.length; i++) shots[i - 1].end = shots[i].start;

// Subtítulos karaoke (motor: burnCaptions false; exporta el .srt)
const captions = JSON.parse(fs.readFileSync('captions.json', 'utf8'));
const cap = captionTrack(WORDS, captions);
for (const s of shots) s.layers.push(...cap(s.start, s.end));
// Efectos: ligeros, en huecos de la voz.
const sfx = [
  F(0.05, 'canon', 0.3), F(2.57, 'whoosh', 0.25), F(3.1, 'canon', 0.3), F(3.99, 'whoosh', 0.2), F(4.5, 'boing', 0.3), F(6.27, 'whoosh', 0.2), F(7.7, 'drop', 0.35), F(8.4, 'scratch', 0.3),
  F(8.89, 'whoosh', 0.2), F(10.6, 'whoosh', 0.15), F(10.66, 'boing', 0.25), F(11.22, 'boing', 0.25), F(11.78, 'boing', 0.25), F(12.4, 'whoosh', 0.2), F(14.0, 'whoosh', 0.2), F(15.21, 'whoosh', 0.2),
  F(16.55, 'whoosh', 0.2), F(17.0, 'drop', 0.4), F(17.5, 'drop', 0.35), F(18.5, 'whoosh', 0.2), F(18.7, 'puf', 0.3), F(19.85, 'whoosh', 0.2), F(20.8, 'boing', 0.3),
  F(21.83, 'whoosh', 0.2), F(22.2, 'boing', 0.3), F(23.87, 'whoosh', 0.15), F(24.76, 'whoosh', 0.2), F(25.8, 'scratch', 0.3), F(26.61, 'whoosh', 0.2),
  F(28.25, 'whoosh', 0.2), F(29.5, 'canon', 0.3), F(30.17, 'whoosh', 0.2), F(31.0, 'boing', 0.35), F(31.82, 'whoosh', 0.25), F(31.86, 'boing', 0.4), F(32.65, 'whoosh', 0.2), F(33.55, 'drop', 0.4),
  F(34.41, 'whoosh', 0.15), F(36.57, 'whoosh', 0.2), F(36.7, 'drop', 0.25), F(38.23, 'whoosh', 0.2), F(40.69, 'whoosh', 0.2), F(41.1, 'crowd', 0.15), F(42.71, 'whoosh', 0.2),
  F(45.33, 'whoosh', 0.3), F(45.4, 'impresora', 0.25), F(46.31, 'whoosh', 0.2), F(48.35, 'whoosh', 0.2), F(49.95, 'boing', 0.4), F(50.75, 'whoosh', 0.2),
  F(51.7, 'drop', 0.4), F(52.8, 'drop', 0.5), F(53.99, 'whoosh', 0.2), F(56.61, 'whoosh', 0.2), F(56.9, 'scratch', 0.3), F(59.12, 'whoosh', 0.3),
];
fs.writeFileSync('project.json', JSON.stringify({version: 1, style: 'B3', width: 1080, height: 1920, fps: 30, voice: {path: 'narration.mp3', lead: 0, tail: r3(END - VOICE)}, television: {enabled: false}, music: {path: 'music-duck.wav', gain: 0.17}, burnCaptions: false, captions, shots, sfx}, null, 1));
