[
 {
  "start": 0.03,
  "end": 1.38,
  "text": "Metió cien flechas"
 },
 {
  "start": 1.39,
  "end": 1.9,
  "text": "en un carro"
 },
 {
  "start": 1.91,
  "end": 2.884,
  "text": "de madera."
 },
 {
  "start": 2.894,
  "end": 3.58,
  "text": "Y lo apuntó"
 },
 {
  "start": 3.59,
  "end": 4.5,
  "text": "a treinta mil"
 },
 {
  "start": 4.51,
  "end": 5.7,
  "text": "soldados."
 },
 {
  "start": 5.71,
  "end": 6.58,
  "text": "Corea."
 },
 {
  "start": 6.59,
  "end": 7.74,
  "text": "Arriba de la colina,"
 },
 {
  "start": 7.75,
  "end": 8.98,
  "text": "el general Gwon Yul"
 },
 {
  "start": 8.99,
  "end": 9.62,
  "text": "con dos mil"
 },
 {
  "start": 9.63,
  "end": 11.113,
  "text": "trescientos hombres."
 },
 {
  "start": 11.123,
  "end": 11.94,
  "text": "Algunos,"
 },
 {
  "start": 11.95,
  "end": 12.82,
  "text": "monjes."
 },
 {
  "start": 12.83,
  "end": 13.54,
  "text": "Abajo,"
 },
 {
  "start": 13.55,
  "end": 14.62,
  "text": "los japoneses:"
 },
 {
  "start": 14.63,
  "end": 16.14,
  "text": "más de diez a uno."
 },
 {
  "start": 16.15,
  "end": 16.9,
  "text": "Un soldado mira"
 },
 {
  "start": 16.91,
  "end": 17.78,
  "text": "el carro:"
 },
 {
  "start": 17.79,
  "end": 18.42,
  "text": "\"General,"
 },
 {
  "start": 18.43,
  "end": 19.66,
  "text": "¿eso es un arma..."
 },
 {
  "start": 19.67,
  "end": 20.22,
  "text": "o un carro"
 },
 {
  "start": 20.23,
  "end": 21.2,
  "text": "de la compra?\""
 },
 {
  "start": 21.2,
  "end": 22.36,
  "text": "\"Que se acerquen.\""
 },
 {
  "start": 22.36,
  "end": 23.14,
  "text": "Y suben."
 },
 {
  "start": 23.15,
  "end": 24.88,
  "text": "Oleada tras oleada."
 },
 {
  "start": 24.89,
  "end": 25.38,
  "text": "\"¿Ahora,"
 },
 {
  "start": 25.39,
  "end": 26.25,
  "text": "general?\""
 },
 {
  "start": 26.25,
  "end": 26.98,
  "text": "\"Ahora.\""
 },
 {
  "start": 26.99,
  "end": 28.42,
  "text": "Encienden la mecha."
 },
 {
  "start": 28.43,
  "end": 29.46,
  "text": "Son cohetes."
 },
 {
  "start": 29.47,
  "end": 30.5,
  "text": "Y salen las cien"
 },
 {
  "start": 30.51,
  "end": 31.38,
  "text": "a la vez."
 },
 {
  "start": 31.39,
  "end": 32.1,
  "text": "Cien."
 },
 {
  "start": 32.11,
  "end": 32.9,
  "text": "A la vez."
 },
 {
  "start": 32.91,
  "end": 33.46,
  "text": "La impresora"
 },
 {
  "start": 33.47,
  "end": 34.5,
  "text": "del Archivo no saca"
 },
 {
  "start": 34.51,
  "end": 35.7,
  "text": "ni dos hojas."
 },
 {
  "start": 35.71,
  "end": 36.9,
  "text": "Vuelven a atacar."
 },
 {
  "start": 36.91,
  "end": 38.26,
  "text": "Una y otra vez."
 },
 {
  "start": 38.27,
  "end": 38.57,
  "text": "Hasta que"
 },
 {
  "start": 38.57,
  "end": 39.46,
  "text": "a los coreanos se les"
 },
 {
  "start": 39.47,
  "end": 40.74,
  "text": "acaban las flechas."
 },
 {
  "start": 40.75,
  "end": 41.66,
  "text": "\"General..."
 },
 {
  "start": 41.67,
  "end": 42.724,
  "text": "se han acabado.\""
 },
 {
  "start": 42.734,
  "end": 44.1,
  "text": "Y por el río aparecen"
 },
 {
  "start": 44.11,
  "end": 44.887,
  "text": "barcos."
 },
 {
  "start": 44.897,
  "end": 46.5,
  "text": "Cargados de flechas."
 },
 {
  "start": 46.51,
  "end": 47.38,
  "text": "Al anochecer,"
 },
 {
  "start": 47.39,
  "end": 48.02,
  "text": "los japoneses"
 },
 {
  "start": 48.03,
  "end": 48.82,
  "text": "se retiran."
 },
 {
  "start": 48.83,
  "end": 49.38,
  "text": "Y cuentan"
 },
 {
  "start": 49.39,
  "end": 50.46,
  "text": "que las mujeres subían"
 },
 {
  "start": 50.47,
  "end": 50.86,
  "text": "piedras"
 },
 {
  "start": 50.87,
  "end": 51.807,
  "text": "en el delantal..."
 },
 {
  "start": 51.817,
  "end": 52.38,
  "text": "y que por eso"
 },
 {
  "start": 52.39,
  "end": 53.54,
  "text": "el delantal se llama"
 },
 {
  "start": 53.55,
  "end": 54.951,
  "text": "\"haengju chima\"."
 },
 {
  "start": 54.961,
  "end": 55.62,
  "text": "Precioso."
 },
 {
  "start": 55.63,
  "end": 56.62,
  "text": "Pero esa palabra ya"
 },
 {
  "start": 56.63,
  "end": 57.22,
  "text": "sale en un libro"
 },
 {
  "start": 57.23,
  "end": 58.78,
  "text": "de setenta y seis años"
 },
 {
  "start": 58.79,
  "end": 59.26,
  "text": "antes."
 },
 {
  "start": 59.27,
  "end": 60.967,
  "text": "Y \"haengju\" es..."
 },
 {
  "start": 60.977,
  "end": 62.5,
  "text": "el trapo de cocina."
 },
 {
  "start": 62.51,
  "end": 63.7,
  "text": "Cien cohetes,"
 },
 {
  "start": 63.71,
  "end": 64.42,
  "text": "treinta mil"
 },
 {
  "start": 64.43,
  "end": 65.247,
  "text": "enemigos..."
 },
 {
  "start": 65.257,
  "end": 65.78,
  "text": "y el invento"
 },
 {
  "start": 65.79,
  "end": 66.9,
  "text": "que sigue sin funcionar"
 },
 {
  "start": 66.91,
  "end": 68.45,
  "text": "es mi nómina."
 },
 {
  "start": 68.75,
  "end": 69.38,
  "text": "Doscientos"
 },
 {
  "start": 69.39,
  "end": 70.46,
  "text": "veintisiete días"
 },
 {
  "start": 70.47,
  "end": 71.82,
  "text": "sin cobrar."
 }
]