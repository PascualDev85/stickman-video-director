[
 {
  "start": 0.181,
  "end": 0.94,
  "text": "Santa Anna perdió"
 },
 {
  "start": 0.95,
  "end": 1.902,
  "text": "una pierna por culpa"
 },
 {
  "start": 1.912,
  "end": 3.118,
  "text": "de unos pasteles."
 },
 {
  "start": 3.228,
  "end": 4.103,
  "text": "Unos oficiales"
 },
 {
  "start": 4.113,
  "end": 4.526,
  "text": "arrasan"
 },
 {
  "start": 4.536,
  "end": 5.18,
  "text": "la pastelería"
 },
 {
  "start": 5.19,
  "end": 6.09,
  "text": "de un francés."
 },
 {
  "start": 6.1,
  "end": 6.898,
  "text": "La tienda no valía"
 },
 {
  "start": 6.908,
  "end": 7.942,
  "text": "ni mil pesos."
 },
 {
  "start": 7.952,
  "end": 8.988,
  "text": "Pide..."
 },
 {
  "start": 8.998,
  "end": 9.298,
  "text": "espera,"
 },
 {
  "start": 9.298,
  "end": 10.595,
  "text": "que lo leo bien..."
 },
 {
  "start": 10.605,
  "end": 11.635,
  "text": "sesenta mil."
 },
 {
  "start": 11.645,
  "end": 12.865,
  "text": "Francia le apoya."
 },
 {
  "start": 12.875,
  "end": 13.854,
  "text": "Con barcos."
 },
 {
  "start": 13.864,
  "end": 14.677,
  "text": "Y ya puestos,"
 },
 {
  "start": 14.687,
  "end": 15.408,
  "text": "pide seiscientos"
 },
 {
  "start": 15.418,
  "end": 16.024,
  "text": "mil."
 },
 {
  "start": 16.034,
  "end": 16.87,
  "text": "Santa Anna defiende"
 },
 {
  "start": 16.88,
  "end": 17.755,
  "text": "Veracruz..."
 },
 {
  "start": 17.765,
  "end": 18.562,
  "text": "y un cañonazo"
 },
 {
  "start": 18.572,
  "end": 19.742,
  "text": "le alcanza la pierna."
 },
 {
  "start": 19.752,
  "end": 20.593,
  "text": "Se la amputan."
 },
 {
  "start": 20.603,
  "end": 21.439,
  "text": "México acaba"
 },
 {
  "start": 21.449,
  "end": 22.483,
  "text": "aceptando pagar."
 },
 {
  "start": 22.493,
  "end": 23.57,
  "text": "Pero lo raro empieza"
 },
 {
  "start": 23.58,
  "end": 24.075,
  "text": "ahora."
 },
 {
  "start": 24.085,
  "end": 24.768,
  "text": "La entierra"
 },
 {
  "start": 24.778,
  "end": 26.214,
  "text": "con honores militares."
 },
 {
  "start": 26.224,
  "end": 27.039,
  "text": "A la pierna."
 },
 {
  "start": 27.049,
  "end": 27.77,
  "text": "Años después,"
 },
 {
  "start": 27.78,
  "end": 28.424,
  "text": "la desentierra"
 },
 {
  "start": 28.434,
  "end": 29.832,
  "text": "para un segundo funeral:"
 },
 {
  "start": 29.842,
  "end": 30.563,
  "text": "carroza,"
 },
 {
  "start": 30.573,
  "end": 31.255,
  "text": "desfile,"
 },
 {
  "start": 31.265,
  "end": 32.268,
  "text": "discursos."
 },
 {
  "start": 32.278,
  "end": 33.164,
  "text": "Para una pierna."
 },
 {
  "start": 33.174,
  "end": 34.087,
  "text": "Hasta que una turba"
 },
 {
  "start": 34.097,
  "end": 35.125,
  "text": "enfadada con él..."
 },
 {
  "start": 35.185,
  "end": 35.916,
  "text": "la desentierra"
 },
 {
  "start": 35.993,
  "end": 36.532,
  "text": "otra vez"
 },
 {
  "start": 36.608,
  "end": 37.108,
  "text": "y la pasea"
 },
 {
  "start": 37.147,
  "end": 37.71,
  "text": "por la calle."
 },
 {
  "start": 37.77,
  "end": 38.67,
  "text": "¿Y la de corcho?"
 },
 {
  "start": 38.68,
  "end": 39.247,
  "text": "Se la quitaron"
 },
 {
  "start": 39.257,
  "end": 40.439,
  "text": "los estadounidenses,"
 },
 {
  "start": 40.449,
  "end": 41.055,
  "text": "dicen que mientras"
 },
 {
  "start": 41.065,
  "end": 42.042,
  "text": "comía pollo."
 },
 {
  "start": 42.052,
  "end": 43.324,
  "text": "Y no la devuelven."
 },
 {
  "start": 43.334,
  "end": 44.465,
  "text": "Expediente cerrado."
 },
 {
  "start": 44.525,
  "end": 45.025,
  "text": "Esa pierna"
 },
 {
  "start": 45.102,
  "end": 46.332,
  "text": "tuvo dos funerales."
 },
 {
  "start": 47.244,
  "end": 47.888,
  "text": "Yo no he tenido"
 },
 {
  "start": 47.898,
  "end": 49.482,
  "text": "ni una nómina."
 }
]