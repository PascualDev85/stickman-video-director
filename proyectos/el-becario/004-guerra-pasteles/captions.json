[
 {
  "start": 0.181,
  "end": 0.94,
  "text": "Santa Anna perdió"
 },
 {
  "start": 0.95,
  "end": 1.902,
  "text": "una pierna por culpa"
 },
 {
  "start": 1.912,
  "end": 3.118,
  "text": "de unos pasteles."
 },
 {
  "start": 3.128,
  "end": 5.018,
  "text": "Expediente 004."
 },
 {
  "start": 5.028,
  "end": 5.903,
  "text": "Unos oficiales"
 },
 {
  "start": 5.913,
  "end": 6.326,
  "text": "arrasan"
 },
 {
  "start": 6.336,
  "end": 6.98,
  "text": "la pastelería"
 },
 {
  "start": 6.99,
  "end": 7.89,
  "text": "de un francés."
 },
 {
  "start": 7.9,
  "end": 8.698,
  "text": "La tienda no valía"
 },
 {
  "start": 8.708,
  "end": 9.742,
  "text": "ni mil pesos."
 },
 {
  "start": 9.752,
  "end": 10.788,
  "text": "Pide..."
 },
 {
  "start": 10.798,
  "end": 11.098,
  "text": "espera,"
 },
 {
  "start": 11.098,
  "end": 12.395,
  "text": "que lo leo bien..."
 },
 {
  "start": 12.405,
  "end": 13.435,
  "text": "sesenta mil."
 },
 {
  "start": 13.445,
  "end": 14.665,
  "text": "Francia le apoya."
 },
 {
  "start": 14.675,
  "end": 15.654,
  "text": "Con barcos."
 },
 {
  "start": 15.664,
  "end": 16.477,
  "text": "Y ya puestos,"
 },
 {
  "start": 16.487,
  "end": 17.208,
  "text": "pide seiscientos"
 },
 {
  "start": 17.218,
  "end": 17.824,
  "text": "mil."
 },
 {
  "start": 17.834,
  "end": 18.67,
  "text": "Santa Anna defiende"
 },
 {
  "start": 18.68,
  "end": 19.555,
  "text": "Veracruz..."
 },
 {
  "start": 19.565,
  "end": 20.362,
  "text": "y un cañonazo"
 },
 {
  "start": 20.372,
  "end": 21.542,
  "text": "le alcanza la pierna."
 },
 {
  "start": 21.552,
  "end": 22.393,
  "text": "Se la amputan."
 },
 {
  "start": 22.403,
  "end": 23.239,
  "text": "México acaba"
 },
 {
  "start": 23.249,
  "end": 24.283,
  "text": "aceptando pagar."
 },
 {
  "start": 24.293,
  "end": 25.37,
  "text": "Pero lo raro empieza"
 },
 {
  "start": 25.38,
  "end": 25.875,
  "text": "ahora."
 },
 {
  "start": 25.885,
  "end": 26.568,
  "text": "La entierra"
 },
 {
  "start": 26.578,
  "end": 28.014,
  "text": "con honores militares."
 },
 {
  "start": 28.024,
  "end": 28.839,
  "text": "A la pierna."
 },
 {
  "start": 28.849,
  "end": 29.57,
  "text": "Años después,"
 },
 {
  "start": 29.58,
  "end": 30.224,
  "text": "la desentierra"
 },
 {
  "start": 30.234,
  "end": 31.632,
  "text": "para un segundo funeral:"
 },
 {
  "start": 31.642,
  "end": 32.363,
  "text": "carroza,"
 },
 {
  "start": 32.373,
  "end": 33.055,
  "text": "desfile,"
 },
 {
  "start": 33.065,
  "end": 34.068,
  "text": "discursos."
 },
 {
  "start": 34.078,
  "end": 34.964,
  "text": "Para una pierna."
 },
 {
  "start": 34.974,
  "end": 35.887,
  "text": "Hasta que una turba"
 },
 {
  "start": 35.897,
  "end": 36.925,
  "text": "enfadada con él..."
 },
 {
  "start": 36.985,
  "end": 37.716,
  "text": "la desentierra"
 },
 {
  "start": 37.793,
  "end": 38.332,
  "text": "otra vez"
 },
 {
  "start": 38.408,
  "end": 38.908,
  "text": "y la pasea"
 },
 {
  "start": 38.947,
  "end": 39.51,
  "text": "por la calle."
 },
 {
  "start": 39.57,
  "end": 40.47,
  "text": "¿Y la de corcho?"
 },
 {
  "start": 40.48,
  "end": 41.047,
  "text": "Se la quitaron"
 },
 {
  "start": 41.057,
  "end": 42.239,
  "text": "los estadounidenses,"
 },
 {
  "start": 42.249,
  "end": 42.855,
  "text": "dicen que mientras"
 },
 {
  "start": 42.865,
  "end": 43.842,
  "text": "comía pollo."
 },
 {
  "start": 43.852,
  "end": 45.124,
  "text": "Y no la devuelven."
 },
 {
  "start": 45.134,
  "end": 46.265,
  "text": "Expediente cerrado."
 },
 {
  "start": 46.325,
  "end": 46.825,
  "text": "Esa pierna"
 },
 {
  "start": 46.902,
  "end": 48.132,
  "text": "tuvo dos funerales."
 },
 {
  "start": 49.044,
  "end": 49.688,
  "text": "Yo no he tenido"
 },
 {
  "start": 49.698,
  "end": 51.282,
  "text": "ni una nómina."
 }
]