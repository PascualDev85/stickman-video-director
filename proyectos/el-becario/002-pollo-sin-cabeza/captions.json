[
 {
  "start": 0.08,
  "end": 1.12,
  "text": "Este pollo vivió"
 },
 {
  "start": 1.24,
  "end": 2.68,
  "text": "dieciocho meses..."
 },
 {
  "start": 3.04,
  "end": 3.88,
  "text": "sin cabeza."
 },
 {
  "start": 4.48,
  "end": 6.36,
  "text": "Expediente 002."
 },
 {
  "start": 6.996,
  "end": 8.92,
  "text": "Colorado, 1945."
 },
 {
  "start": 8.96,
  "end": 10.16,
  "text": "Viene a cenar la suegra..."
 },
 {
  "start": 10.4,
  "end": 11.36,
  "text": "y el granjero va"
 },
 {
  "start": 11.4,
  "end": 12.28,
  "text": "a por un pollo."
 },
 {
  "start": 12.464,
  "end": 13.08,
  "text": "Hachazo..."
 },
 {
  "start": 13.269,
  "end": 14.4,
  "text": "y el pollo se levanta."
 },
 {
  "start": 14.56,
  "end": 15.48,
  "text": "Y se va andando."
 },
 {
  "start": 15.68,
  "end": 16.68,
  "text": "Al día siguiente..."
 },
 {
  "start": 16.88,
  "end": 17.6,
  "text": "sigue vivo."
 },
 {
  "start": 18.046,
  "end": 18.32,
  "text": "¿Cómo?"
 },
 {
  "start": 18.56,
  "end": 19.6,
  "text": "El hacha le dejó casi"
 },
 {
  "start": 19.68,
  "end": 20.24,
  "text": "todo el tronco"
 },
 {
  "start": 20.32,
  "end": 21.093,
  "text": "del cerebro:"
 },
 {
  "start": 21.147,
  "end": 22.52,
  "text": "lo justo para respirar..."
 },
 {
  "start": 22.56,
  "end": 23.307,
  "text": "y andar."
 },
 {
  "start": 23.333,
  "end": 23.76,
  "text": "Lo alimentan"
 },
 {
  "start": 23.84,
  "end": 24.667,
  "text": "con un gotero..."
 },
 {
  "start": 24.693,
  "end": 25.68,
  "text": "y le limpian la garganta"
 },
 {
  "start": 25.72,
  "end": 26.651,
  "text": "con una jeringa."
 },
 {
  "start": 26.72,
  "end": 28.12,
  "text": "Hasta intenta cantar."
 },
 {
  "start": 29.324,
  "end": 30.98,
  "text": "Suena a tubería atascada."
 },
 {
  "start": 31.087,
  "end": 31.927,
  "text": "Lo llaman Mike,"
 },
 {
  "start": 31.953,
  "end": 32.62,
  "text": "y se va de gira"
 },
 {
  "start": 32.74,
  "end": 33.767,
  "text": "por todo el país."
 },
 {
  "start": 33.793,
  "end": 35.267,
  "text": "La gente paga por verlo."
 },
 {
  "start": 35.38,
  "end": 36.946,
  "text": "A mí, ni gratis."
 },
 {
  "start": 37.015,
  "end": 37.941,
  "text": "Pero una noche,"
 },
 {
  "start": 37.981,
  "end": 38.901,
  "text": "en un motel,"
 },
 {
  "start": 38.941,
  "end": 39.941,
  "text": "se atraganta..."
 },
 {
  "start": 39.981,
  "end": 40.621,
  "text": "y no encuentran"
 },
 {
  "start": 40.661,
  "end": 41.541,
  "text": "la jeringa."
 },
 {
  "start": 41.695,
  "end": 42.461,
  "text": "Hoy su pueblo le hace"
 },
 {
  "start": 42.501,
  "end": 43.91,
  "text": "un festival cada año."
 },
 {
  "start": 43.981,
  "end": 45.272,
  "text": "Expediente cerrado."
 },
 {
  "start": 45.341,
  "end": 46.221,
  "text": "Dieciocho meses"
 },
 {
  "start": 46.341,
  "end": 47.387,
  "text": "sin cabeza..."
 },
 {
  "start": 47.661,
  "end": 48.221,
  "text": "y yo no aguanto"
 },
 {
  "start": 48.261,
  "end": 49.181,
  "text": "ni un lunes."
 }
]