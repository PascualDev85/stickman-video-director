[
 {
  "start": 0.08,
  "end": 1.12,
  "text": "Este pollo vivió"
 },
 {
  "start": 1.24,
  "end": 2.68,
  "text": "dieciocho meses..."
 },
 {
  "start": 3.04,
  "end": 3.88,
  "text": "sin cabeza."
 },
 {
  "start": 4.48,
  "end": 6.36,
  "text": "Expediente 002."
 },
 {
  "start": 6.996,
  "end": 8.92,
  "text": "Colorado, 1945."
 },
 {
  "start": 8.96,
  "end": 10.16,
  "text": "Viene a cenar la suegra..."
 },
 {
  "start": 10.4,
  "end": 11.36,
  "text": "y el granjero va"
 },
 {
  "start": 11.4,
  "end": 12.28,
  "text": "a por un pollo."
 },
 {
  "start": 12.464,
  "end": 13.08,
  "text": "Hachazo..."
 },
 {
  "start": 13.269,
  "end": 14.4,
  "text": "y el pollo se levanta."
 },
 {
  "start": 14.56,
  "end": 15.48,
  "text": "Y se va andando."
 },
 {
  "start": 15.68,
  "end": 16.68,
  "text": "Al día siguiente..."
 },
 {
  "start": 16.88,
  "end": 17.6,
  "text": "sigue vivo."
 },
 {
  "start": 18.046,
  "end": 18.32,
  "text": "¿Cómo?"
 },
 {
  "start": 18.56,
  "end": 19.6,
  "text": "El hacha le dejó casi"
 },
 {
  "start": 19.68,
  "end": 20.24,
  "text": "todo el tronco"
 },
 {
  "start": 20.32,
  "end": 21.093,
  "text": "del cerebro:"
 },
 {
  "start": 21.147,
  "end": 22.52,
  "text": "lo justo para respirar..."
 },
 {
  "start": 22.56,
  "end": 23.307,
  "text": "y andar."
 },
 {
  "start": 23.333,
  "end": 23.76,
  "text": "Lo alimentan"
 },
 {
  "start": 23.84,
  "end": 24.667,
  "text": "con un gotero..."
 },
 {
  "start": 24.693,
  "end": 25.68,
  "text": "y le limpian la garganta"
 },
 {
  "start": 25.72,
  "end": 26.651,
  "text": "con una jeringa."
 },
 {
  "start": 26.72,
  "end": 28.12,
  "text": "Hasta intenta cantar."
 },
 {
  "start": 28.224,
  "end": 29.88,
  "text": "Suena a tubería atascada."
 },
 {
  "start": 29.987,
  "end": 30.827,
  "text": "Lo llaman Mike,"
 },
 {
  "start": 30.853,
  "end": 31.52,
  "text": "y se va de gira"
 },
 {
  "start": 31.64,
  "end": 32.667,
  "text": "por todo el país."
 },
 {
  "start": 32.693,
  "end": 34.167,
  "text": "La gente paga por verlo."
 },
 {
  "start": 34.28,
  "end": 35.846,
  "text": "A mí, ni gratis."
 },
 {
  "start": 35.915,
  "end": 36.841,
  "text": "Pero una noche,"
 },
 {
  "start": 36.881,
  "end": 37.801,
  "text": "en un motel,"
 },
 {
  "start": 37.841,
  "end": 38.841,
  "text": "se atraganta..."
 },
 {
  "start": 38.881,
  "end": 39.521,
  "text": "y no encuentran"
 },
 {
  "start": 39.561,
  "end": 40.441,
  "text": "la jeringa."
 },
 {
  "start": 40.595,
  "end": 41.361,
  "text": "Hoy su pueblo le hace"
 },
 {
  "start": 41.401,
  "end": 42.81,
  "text": "un festival cada año."
 },
 {
  "start": 42.881,
  "end": 44.172,
  "text": "Expediente cerrado."
 },
 {
  "start": 44.241,
  "end": 45.121,
  "text": "Dieciocho meses"
 },
 {
  "start": 45.241,
  "end": 46.287,
  "text": "sin cabeza..."
 },
 {
  "start": 46.561,
  "end": 47.121,
  "text": "y yo no aguanto"
 },
 {
  "start": 47.161,
  "end": 48.081,
  "text": "ni un lunes."
 }
]