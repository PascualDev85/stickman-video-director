[
 {
  "start": 0.08,
  "end": 1.12,
  "text": "Este pollo vivió"
 },
 {
  "start": 1.24,
  "end": 2.68,
  "text": "dieciocho meses..."
 },
 {
  "start": 3.04,
  "end": 3.88,
  "text": "sin cabeza."
 },
 {
  "start": 4.13,
  "end": 6.01,
  "text": "Expediente 002."
 },
 {
  "start": 6.256,
  "end": 8.18,
  "text": "Colorado, 1945."
 },
 {
  "start": 8.22,
  "end": 9.42,
  "text": "Viene a cenar la suegra..."
 },
 {
  "start": 9.66,
  "end": 10.62,
  "text": "y el granjero va"
 },
 {
  "start": 10.66,
  "end": 11.54,
  "text": "a por un pollo."
 },
 {
  "start": 11.724,
  "end": 12.34,
  "text": "Hachazo..."
 },
 {
  "start": 12.529,
  "end": 13.66,
  "text": "y el pollo se levanta."
 },
 {
  "start": 13.82,
  "end": 14.74,
  "text": "Y se va andando."
 },
 {
  "start": 14.94,
  "end": 15.94,
  "text": "Al día siguiente..."
 },
 {
  "start": 16.14,
  "end": 16.86,
  "text": "sigue vivo."
 },
 {
  "start": 17.056,
  "end": 17.33,
  "text": "¿Cómo?"
 },
 {
  "start": 17.57,
  "end": 18.61,
  "text": "El hacha le dejó casi"
 },
 {
  "start": 18.69,
  "end": 19.25,
  "text": "todo el tronco"
 },
 {
  "start": 19.33,
  "end": 20.103,
  "text": "del cerebro:"
 },
 {
  "start": 20.157,
  "end": 21.53,
  "text": "lo justo para respirar..."
 },
 {
  "start": 21.57,
  "end": 22.317,
  "text": "y andar."
 },
 {
  "start": 22.343,
  "end": 22.77,
  "text": "Lo alimentan"
 },
 {
  "start": 22.85,
  "end": 23.677,
  "text": "con un gotero..."
 },
 {
  "start": 23.703,
  "end": 24.69,
  "text": "y le limpian la garganta"
 },
 {
  "start": 24.73,
  "end": 25.661,
  "text": "con una jeringa."
 },
 {
  "start": 25.73,
  "end": 27.13,
  "text": "Hasta intenta cantar."
 },
 {
  "start": 28.334,
  "end": 29.99,
  "text": "Suena a tubería atascada."
 },
 {
  "start": 30.097,
  "end": 30.937,
  "text": "Lo llaman Mike,"
 },
 {
  "start": 30.963,
  "end": 31.63,
  "text": "y se va de gira"
 },
 {
  "start": 31.75,
  "end": 32.777,
  "text": "por todo el país."
 },
 {
  "start": 32.803,
  "end": 34.277,
  "text": "La gente paga por verlo."
 },
 {
  "start": 34.39,
  "end": 35.956,
  "text": "A mí, ni gratis."
 },
 {
  "start": 36.025,
  "end": 36.951,
  "text": "Pero una noche,"
 },
 {
  "start": 36.991,
  "end": 37.911,
  "text": "en un motel,"
 },
 {
  "start": 37.951,
  "end": 38.951,
  "text": "se atraganta..."
 },
 {
  "start": 38.991,
  "end": 39.631,
  "text": "y no encuentran"
 },
 {
  "start": 39.671,
  "end": 40.551,
  "text": "la jeringa."
 },
 {
  "start": 40.705,
  "end": 41.471,
  "text": "Hoy su pueblo le hace"
 },
 {
  "start": 41.511,
  "end": 42.92,
  "text": "un festival cada año."
 },
 {
  "start": 42.991,
  "end": 44.282,
  "text": "Expediente cerrado."
 },
 {
  "start": 44.351,
  "end": 45.231,
  "text": "Dieciocho meses"
 },
 {
  "start": 45.351,
  "end": 46.397,
  "text": "sin cabeza..."
 },
 {
  "start": 46.671,
  "end": 47.231,
  "text": "y yo no aguanto"
 },
 {
  "start": 47.271,
  "end": 48.191,
  "text": "ni un lunes."
 }
]