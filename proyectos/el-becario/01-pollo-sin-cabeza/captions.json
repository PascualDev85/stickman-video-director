[
 {
  "start": 0.88,
  "end": 2.16,
  "text": "Expediente catorce."
 },
 {
  "start": 2.72,
  "end": 4.08,
  "text": "Este pollo vivió un año"
 },
 {
  "start": 4.12,
  "end": 5.04,
  "text": "y medio…"
 },
 {
  "start": 5.12,
  "end": 5.96,
  "text": "sin cabeza."
 },
 {
  "start": 6.304,
  "end": 6.68,
  "text": "Sí."
 },
 {
  "start": 6.88,
  "end": 7.92,
  "text": "Sin cabeza."
 },
 {
  "start": 8.16,
  "end": 8.88,
  "text": "Colorado,"
 },
 {
  "start": 8.96,
  "end": 10.72,
  "text": "1945."
 },
 {
  "start": 10.8,
  "end": 12,
  "text": "Un granjero sale a buscar"
 },
 {
  "start": 12.04,
  "end": 12.72,
  "text": "la cena."
 },
 {
  "start": 12.8,
  "end": 13.84,
  "text": "Agarra un pollo,"
 },
 {
  "start": 13.92,
  "end": 14.88,
  "text": "un hachazo…"
 },
 {
  "start": 14.96,
  "end": 16.4,
  "text": "y el pollo se levanta."
 },
 {
  "start": 16.47,
  "end": 17.6,
  "text": "Y sigue caminando,"
 },
 {
  "start": 17.68,
  "end": 18.56,
  "text": "como si nada."
 },
 {
  "start": 18.64,
  "end": 19.88,
  "text": "Como yo los lunes."
 },
 {
  "start": 20.16,
  "end": 21.36,
  "text": "A la mañana siguiente…"
 },
 {
  "start": 21.44,
  "end": 22.4,
  "text": "seguía vivo."
 },
 {
  "start": 22.507,
  "end": 23.12,
  "text": "¿Cómo?"
 },
 {
  "start": 23.2,
  "end": 24.56,
  "text": "El hachazo le dejó casi"
 },
 {
  "start": 24.68,
  "end": 25.28,
  "text": "todo el tronco"
 },
 {
  "start": 25.36,
  "end": 26.08,
  "text": "del cerebro:"
 },
 {
  "start": 26.16,
  "end": 26.96,
  "text": "la parte que controla"
 },
 {
  "start": 27,
  "end": 27.68,
  "text": "el corazón"
 },
 {
  "start": 27.72,
  "end": 28.8,
  "text": "y la respiración."
 },
 {
  "start": 28.88,
  "end": 30,
  "text": "Así que el granjero hizo"
 },
 {
  "start": 30.04,
  "end": 30.8,
  "text": "lo lógico:"
 },
 {
  "start": 30.84,
  "end": 32.32,
  "text": "lo alimentó con un gotero."
 },
 {
  "start": 32.56,
  "end": 33.76,
  "text": "Directo por el cuello."
 },
 {
  "start": 33.8,
  "end": 34.88,
  "text": "Lo llamaron Mike."
 },
 {
  "start": 34.92,
  "end": 36.08,
  "text": "Salió en la revista Life"
 },
 {
  "start": 36.12,
  "end": 36.8,
  "text": "y se fue de gira"
 },
 {
  "start": 36.88,
  "end": 38.08,
  "text": "por Estados Unidos."
 },
 {
  "start": 38.16,
  "end": 39.44,
  "text": "La gente pagaba por ver"
 },
 {
  "start": 39.52,
  "end": 40.88,
  "text": "un pollo sin cabeza."
 },
 {
  "start": 40.96,
  "end": 41.92,
  "text": "Mike vivió así"
 },
 {
  "start": 42.08,
  "end": 43.36,
  "text": "dieciocho meses."
 },
 {
  "start": 43.44,
  "end": 44.16,
  "text": "Murió en un motel"
 },
 {
  "start": 44.2,
  "end": 44.96,
  "text": "de Arizona,"
 },
 {
  "start": 45.04,
  "end": 45.68,
  "text": "ahogado,"
 },
 {
  "start": 45.76,
  "end": 46.48,
  "text": "porque esa noche"
 },
 {
  "start": 46.52,
  "end": 47.44,
  "text": "no encontraron con qué"
 },
 {
  "start": 47.52,
  "end": 48.8,
  "text": "limpiarle la garganta."
 },
 {
  "start": 48.867,
  "end": 49.92,
  "text": "Y aun así…"
 },
 {
  "start": 50,
  "end": 51.52,
  "text": "tuvo más fama que yo."
 },
 {
  "start": 51.56,
  "end": 52.72,
  "text": "Su pueblo todavía le hace"
 },
 {
  "start": 52.8,
  "end": 54.4,
  "text": "un festival cada año."
 },
 {
  "start": 54.469,
  "end": 55.36,
  "text": "Y no fue el único"
 },
 {
  "start": 55.44,
  "end": 56.8,
  "text": "pollo que lo intentó…"
 }
]