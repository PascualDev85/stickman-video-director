[
 {
  "start": 0.05,
  "end": 1.235,
  "text": "Dicen que este hombre"
 },
 {
  "start": 1.255,
  "end": 2.44,
  "text": "vendió la Torre Eiffel."
 },
 {
  "start": 2.97,
  "end": 3.8,
  "text": "Y no era suya."
 },
 {
  "start": 4.08,
  "end": 5.81,
  "text": "Expediente 001."
 },
 {
  "start": 6.08,
  "end": 7.45,
  "text": "Yo llevo meses sin cobrar…"
 },
 {
  "start": 7.74,
  "end": 9.12,
  "text": "así que quiero saber cómo."
 },
 {
  "start": 9.38,
  "end": 11.28,
  "text": "París, 1925."
 },
 {
  "start": 11.54,
  "end": 12.383,
  "text": "Victor Lustig lee"
 },
 {
  "start": 12.403,
  "end": 13.592,
  "text": "que mantener la torre"
 },
 {
  "start": 13.612,
  "end": 14.8,
  "text": "cuesta una fortuna…"
 },
 {
  "start": 15.09,
  "end": 15.955,
  "text": "y se le ocurre"
 },
 {
  "start": 15.975,
  "end": 16.746,
  "text": "una idea."
 },
 {
  "start": 16.766,
  "end": 17.769,
  "text": "Imprime papeles falsos"
 },
 {
  "start": 17.789,
  "end": 18.28,
  "text": "del Gobierno,"
 },
 {
  "start": 18.47,
  "end": 19.601,
  "text": "se presenta como alto"
 },
 {
  "start": 19.621,
  "end": 20.609,
  "text": "cargo del Ministerio"
 },
 {
  "start": 20.629,
  "end": 21.76,
  "text": "de Correos y Telégrafos…"
 },
 {
  "start": 22.03,
  "end": 23.17,
  "text": "y reúne a los mayores"
 },
 {
  "start": 23.19,
  "end": 24.185,
  "text": "chatarreros de París"
 },
 {
  "start": 24.205,
  "end": 25.2,
  "text": "en un hotel de lujo."
 },
 {
  "start": 25.47,
  "end": 26.03,
  "text": "Su secreto:"
 },
 {
  "start": 26.29,
  "end": 27.505,
  "text": "el Gobierno va a vender"
 },
 {
  "start": 27.525,
  "end": 28.74,
  "text": "la torre como chatarra."
 },
 {
  "start": 29,
  "end": 29.27,
  "text": "Pero…"
 },
 {
  "start": 29.56,
  "end": 30.18,
  "text": "discreción."
 },
 {
  "start": 30.46,
  "end": 31.4,
  "text": "André Poisson quiere"
 },
 {
  "start": 31.42,
  "end": 32.4,
  "text": "el trato tanto…"
 },
 {
  "start": 32.68,
  "end": 33.799,
  "text": "que encima le paga"
 },
 {
  "start": 33.819,
  "end": 34.45,
  "text": "un soborno."
 },
 {
  "start": 34.72,
  "end": 35.828,
  "text": "Lustig cobra y,"
 },
 {
  "start": 35.848,
  "end": 36.933,
  "text": "en menos de una hora,"
 },
 {
  "start": 36.953,
  "end": 37.9,
  "text": "va camino de Austria."
 },
 {
  "start": 38.29,
  "end": 38.81,
  "text": "¿Poisson?"
 },
 {
  "start": 39.07,
  "end": 40.435,
  "text": "Le da tanta vergüenza"
 },
 {
  "start": 40.455,
  "end": 41.4,
  "text": "que ni lo denuncia."
 },
 {
  "start": 41.66,
  "end": 42.755,
  "text": "Así que Lustig vuelve"
 },
 {
  "start": 42.775,
  "end": 43.87,
  "text": "y lo intenta otra"
 },
 {
  "start": 44.21,
  "end": 44.298,
  "text": "vez."
 },
 {
  "start": 44.318,
  "end": 45.212,
  "text": "Pero esta vez alguien"
 },
 {
  "start": 45.232,
  "end": 46.3,
  "text": "avisa a la policía…"
 },
 {
  "start": 46.49,
  "end": 47.89,
  "text": "y él escapa por poco."
 },
 {
  "start": 48.15,
  "end": 49.205,
  "text": "Años después acabó"
 },
 {
  "start": 49.225,
  "end": 49.82,
  "text": "en Alcatraz…"
 },
 {
  "start": 50.16,
  "end": 51.37,
  "text": "por falsificar billetes."
 },
 {
  "start": 51.63,
  "end": 52.215,
  "text": "La torre,"
 },
 {
  "start": 52.235,
  "end": 52.82,
  "text": "por cierto,"
 },
 {
  "start": 52.99,
  "end": 53.82,
  "text": "sigue en su sitio."
 },
 {
  "start": 54.09,
  "end": 55.1,
  "text": "Expediente cerrado."
 },
 {
  "start": 55.56,
  "end": 56.248,
  "text": "¿Y yo?"
 },
 {
  "start": 56.268,
  "end": 56.94,
  "text": "Sigo sin cobrar."
 }
]