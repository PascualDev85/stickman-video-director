[
 {
  "start": 0.29,
  "end": 1.2,
  "text": "Dicen que este hombre"
 },
 {
  "start": 1.28,
  "end": 2.72,
  "text": "vendió la Torre Eiffel."
 },
 {
  "start": 2.959,
  "end": 3.949,
  "text": "Y no era suya."
 },
 {
  "start": 4.095,
  "end": 5.965,
  "text": "Expediente 001."
 },
 {
  "start": 6.075,
  "end": 7.623,
  "text": "Yo llevo meses sin cobrar…"
 },
 {
  "start": 7.801,
  "end": 9.26,
  "text": "así que quiero saber cómo."
 },
 {
  "start": 9.4,
  "end": 11.565,
  "text": "París, 1925."
 },
 {
  "start": 11.605,
  "end": 12.645,
  "text": "Victor Lustig lee"
 },
 {
  "start": 12.725,
  "end": 13.685,
  "text": "que mantener la torre"
 },
 {
  "start": 13.792,
  "end": 15.152,
  "text": "cuesta una fortuna…"
 },
 {
  "start": 15.178,
  "end": 16.547,
  "text": "y se le ocurre una idea."
 },
 {
  "start": 16.601,
  "end": 17.614,
  "text": "Imprime papeles falsos"
 },
 {
  "start": 17.694,
  "end": 18.521,
  "text": "del Gobierno,"
 },
 {
  "start": 18.547,
  "end": 19.614,
  "text": "se presenta como alto"
 },
 {
  "start": 19.734,
  "end": 20.574,
  "text": "cargo del Ministerio"
 },
 {
  "start": 20.614,
  "end": 22.041,
  "text": "de Correos y Telégrafos…"
 },
 {
  "start": 22.067,
  "end": 23.214,
  "text": "y reúne a los mayores"
 },
 {
  "start": 23.294,
  "end": 24.254,
  "text": "chatarreros de París"
 },
 {
  "start": 24.334,
  "end": 25.434,
  "text": "en un hotel de lujo."
 },
 {
  "start": 25.474,
  "end": 26.258,
  "text": "Su secreto:"
 },
 {
  "start": 26.298,
  "end": 27.498,
  "text": "el Gobierno va a vender"
 },
 {
  "start": 27.578,
  "end": 28.954,
  "text": "la torre como chatarra."
 },
 {
  "start": 29.024,
  "end": 29.544,
  "text": "Pero…"
 },
 {
  "start": 29.584,
  "end": 30.43,
  "text": "discreción."
 },
 {
  "start": 30.47,
  "end": 31.43,
  "text": "André Poisson quiere"
 },
 {
  "start": 31.51,
  "end": 32.641,
  "text": "el trato tanto…"
 },
 {
  "start": 32.71,
  "end": 33.75,
  "text": "que encima le paga"
 },
 {
  "start": 33.83,
  "end": 34.75,
  "text": "un soborno."
 },
 {
  "start": 34.79,
  "end": 35.803,
  "text": "Lustig cobra y,"
 },
 {
  "start": 35.83,
  "end": 36.91,
  "text": "en menos de una hora,"
 },
 {
  "start": 36.95,
  "end": 38.239,
  "text": "va camino de Austria."
 },
 {
  "start": 38.301,
  "end": 39.073,
  "text": "¿Poisson?"
 },
 {
  "start": 39.313,
  "end": 40.473,
  "text": "Le da tanta vergüenza"
 },
 {
  "start": 40.553,
  "end": 41.683,
  "text": "que ni lo denuncia."
 },
 {
  "start": 41.723,
  "end": 42.923,
  "text": "Así que Lustig vuelve"
 },
 {
  "start": 42.963,
  "end": 44.183,
  "text": "y lo intenta otra vez."
 },
 {
  "start": 44.223,
  "end": 45.263,
  "text": "Pero esta vez alguien"
 },
 {
  "start": 45.343,
  "end": 46.57,
  "text": "avisa a la policía…"
 },
 {
  "start": 46.596,
  "end": 48.12,
  "text": "y él escapa por poco."
 },
 {
  "start": 48.16,
  "end": 49.307,
  "text": "Años después acabó"
 },
 {
  "start": 49.333,
  "end": 50.213,
  "text": "en Alcatraz…"
 },
 {
  "start": 50.267,
  "end": 51.633,
  "text": "por falsificar billetes."
 },
 {
  "start": 51.702,
  "end": 52.315,
  "text": "La torre,"
 },
 {
  "start": 52.369,
  "end": 53.022,
  "text": "por cierto,"
 },
 {
  "start": 53.062,
  "end": 54.035,
  "text": "sigue en su sitio."
 },
 {
  "start": 54.211,
  "end": 55.565,
  "text": "Expediente cerrado."
 },
 {
  "start": 55.619,
  "end": 56.202,
  "text": "¿Y yo?"
 },
 {
  "start": 56.242,
  "end": 57.202,
  "text": "Sigo sin cobrar."
 }
]