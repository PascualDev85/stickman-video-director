    {
      "start": 0.291,
      "end": 1.451,
      "text": "Want a YouTube channel"
    },
    {
      "start": 1.451,
      "end": 2.716,
      "text": "without being on camera?"
    },
    {
      "start": 2.957,
      "end": 4.273,
      "text": "Start with a stick figure."
    },
    {
      "start": 4.838,
      "end": 6.079,
      "text": "No camera crew."
    },
    {
      "start": 6.098,
      "end": 7.724,
      "text": "No weeks of animation."
    },
    {
      "start": 8.157,
      "end": 9.407,
      "text": "Just a strong hook,"
    },
    {
      "start": 9.595,
      "end": 10.61,
      "text": "a clear story,"
    },
    {
      "start": 10.902,
      "end": 12.011,
      "text": "and an open-source"
    },
    {
      "start": 12.011,
      "end": 12.565,
      "text": "workflow."
    },
    {
      "start": 13.288,
      "end": 13.925,
      "text": "Here's how"
    },
    {
      "start": 13.925,
      "end": 14.943,
      "text": "to turn one idea"
    },
    {
      "start": 14.943,
      "end": 15.986,
      "text": "into a video."
    }
  ],
